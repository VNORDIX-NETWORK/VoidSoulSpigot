+    // VoidSoulSpigot start - selectable knockback models
+    /** The damage source of the hit currently being processed, so knockback can tell an arrow apart from a sword. */
+    private DamageSource knockbackSource;
+    /** Ticks the entity has spent off the ground, used by the CONSTANT model. */
+    public int airTicks;
+    /** Tick of the last hit taken, used by combo mode. */
+    private int lastComboTick = Integer.MIN_VALUE;
+    /** Ground height recorded when the current combo started. */
+    private double comboGroundY;
+
+    void setKnockbackSource(DamageSource damagesource) {
+        this.knockbackSource = damagesource;
+    }
+
+    /**
+     * @return whether the attacker is behind the victim, i.e. the victim is looking away
+     *         from them. 1.7 used a weaker horizontal knockback for these hits, which is
+     *         what makes chasing a fleeing player feel possible.
+     */
+    private boolean isBackHit(Entity attacker) {
+        if (attacker == null) {
+            return false;
+        }
+
+        double dx = attacker.locX - this.locX;
+        double dz = attacker.locZ - this.locZ;
+
+        if (dx == 0.0D && dz == 0.0D) {
+            return false;
+        }
+
+        float yawToAttacker = (float) (Math.atan2(-dx, dz) * 180.0D / Math.PI);
+        return Math.abs(MathHelper.g(yawToAttacker - this.yaw)) > 90.0F;
+    }
+
+    private void applySimpleKnockback(com.voidsoul.spigot.config.VoidSoulWorldConfig.KnockbackConfig config, Entity attacker, double d0, double d1, double magnitude) {
+        double horizontal = config.horizontal;
+
+        if (config.enableOnePointSeven && this.isBackHit(attacker)) {
+            horizontal *= config.onePointSevenMultiplier;
+        }
+
+        double friction = config.friction;
+        this.motX /= friction;
+        this.motY /= friction;
+        this.motZ /= friction;
+
+        this.motX -= d0 / magnitude * horizontal;
+        this.motY += config.vertical;
+        this.motZ -= d1 / magnitude * horizontal;
+
+        if (this.motY > config.verticalLimit) {
+            this.motY = config.verticalLimit;
+        }
+    }
+
+    private void applyAdvancedKnockback(com.voidsoul.spigot.config.VoidSoulWorldConfig.AdvancedConfig config, Entity attacker, double d0, double d1, double magnitude) {
+        double horizontal = config.horizontal;
+        double vertical = config.vertical;
+
+        if (this.onGround) {
+            horizontal *= config.horizontalOnGround;
+            vertical *= config.verticalOnGround;
+        } else {
+            vertical *= config.verticalInAir;
+        }
+
+        if (this.isSprinting()) {
+            horizontal *= config.horizontalSprinting;
+            vertical *= config.verticalSprinting;
+        }
+
+        if (config.enableOnePointSeven && this.isBackHit(attacker)) {
+            horizontal = config.onePointSevenHorizontal;
+        }
+
+        this.motX = config.horizontalInherit ? this.motX * config.horizontalFriction : 0.0D;
+        this.motZ = config.horizontalInherit ? this.motZ * config.horizontalFriction : 0.0D;
+        this.motY = config.verticalInherit ? this.motY * config.verticalFriction : 0.0D;
+
+        this.motX -= d0 / magnitude * horizontal;
+        this.motZ -= d1 / magnitude * horizontal;
+        this.motY += vertical;
+
+        if (config.enableVerticalLimit && this.motY > config.verticalLimit) {
+            this.motY = config.verticalLimit;
+        }
+    }
+
+    private void applyConstantKnockback(com.voidsoul.spigot.config.VoidSoulWorldConfig.ConstantConfig config, Entity attacker, double d0, double d1, double magnitude) {
+        // A sprinting attacker is the one whose sprint gets reset by the hit.
+        boolean sprintReset = attacker instanceof EntityLiving && ((EntityLiving) attacker).isSprinting();
+
+        double horizontal = sprintReset ? config.horizontalSprintReset : config.horizontal;
+        double vertical = this.airTicks >= 20 ? config.verticalLongAir : config.vertical;
+
+        if (config.yawModifier != 0.0D && attacker != null) {
+            // 0 when the victim faces the attacker, 1 when they are turned fully away.
+            double turnedAway = Math.abs(MathHelper.g(this.yaw - attacker.yaw)) / 180.0D;
+            horizontal += horizontal * config.yawModifier * turnedAway;
+        }
+
+        this.motX = 0.0D;
+        this.motY = 0.0D;
+        this.motZ = 0.0D;
+
+        this.motX -= d0 / magnitude * horizontal;
+        this.motZ -= d1 / magnitude * horizontal;
+        this.motY += vertical;
+    }
+
+    /**
+     * Applies the bow knockback overrides when the hit came from an arrow.
+     *
