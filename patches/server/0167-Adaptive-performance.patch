+++ b/src/main/java/net/minecraft/server/EntityPlayer.java
@@ -253,7 +253,9 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
             // VoidSoulSpigot start - chunk send budget
             com.voidsoul.spigot.config.VoidSoulWorldConfig.ChunksConfig.SendConfig sendConfig = this.world.voidsoulConfig.chunks.send;
             int maxChunks = sendConfig.maxChunksPerTick > 0 ? sendConfig.maxChunksPerTick : this.world.spigotConfig.maxBulkChunk;
-            int byteBudget = sendConfig.maxBytesPerTick;
+            // VoidSoulSpigot - while the server is behind, chunks still arrive, just slower.
+            int byteBudget = (int) (sendConfig.maxBytesPerTick
+                    * com.voidsoul.spigot.adaptive.AdaptivePerformance.chunkSendBudgetScale());
             // VoidSoulSpigot end
 
             while (iterator1.hasNext() && arraylist.size() < maxChunks) { // Spigot // VoidSoulSpigot - configurable chunk limit
