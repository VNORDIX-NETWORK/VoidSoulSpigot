From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Velez Garcia <velezgarciaemmanuel25@gmail.com>
Date: Wed, 2 Sep 2026 08:50:16 -0500
Subject: [PATCH] Budget chunk sending by bytes, not just by chunk count

maxBulkChunk counts chunks, so a flat mine chunk and a full cave chunk
cost the same against it when one is about 25 KB and the other 176 KB.
Ten of the large kind is 1.7 MB extracted, copied and queued in a single
tick per player, and a join wave multiplies that by however many people
arrive together - the spike that shows up as MSPT on join and teleport.

The chunk send loop now also tracks bytes. The size comes from
Chunk.getChunkMapSize(), which derives the payload length from the
chunk's non-empty section count, so a chunk that gets held back costs
nothing to skip - the packet is never built. What does not fit simply
goes out on the following tick.

  chunks.send.maxChunksPerTick   per player, 0 keeps spigot's maxBulkChunk
  chunks.send.maxBytesPerTick    per player, default 512 KB
  chunkSending.maxBytesPerTick   server-wide ceiling, off by default

512 KB is deliberately above ten typical mine chunks, so in mine worlds
the chunk count remains the limit that binds and the byte budget only
steps in for dense terrain. The first chunk of a tick is always allowed
through, so a chunk larger than the entire budget cannot wedge a queue.

/vs perf chunks reports deferred sends, so it is visible when the budget
is actually binding rather than assumed.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/com/voidsoul/spigot/chunk/ChunkSendBudget.java b/src/main/java/com/voidsoul/spigot/chunk/ChunkSendBudget.java
new file mode 100644
index 0000000000000000000000000000000000000000..689789d21415f2cfb367deddfc10cc681cde09b2
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/chunk/ChunkSendBudget.java
@@ -0,0 +1,46 @@
+package com.voidsoul.spigot.chunk;
+
+import com.voidsoul.spigot.config.VoidSoulConfig;
+
+/**
+ * The server-wide half of the chunk send budget.
+ * <p>
+ * The per-player budget lives in the send loop itself, because that is where the decision
+ * is made. This is only the ceiling above it: a pool of bytes refilled at the start of
+ * every tick and drawn down by whoever sends first.
+ * <p>
+ * Main thread only - chunk sending happens in the player tick.
+ */
+public final class ChunkSendBudget {
+    private static int remaining;
+    private static boolean enabled;
+
+    private ChunkSendBudget() {
+    }
+
+    /** Refills the pool. Called once at the top of the server tick. */
+    public static void startTick() {
+        int budget = VoidSoulConfig.getChunkSendBytesPerTick();
+
+        enabled = budget > 0;
+        remaining = budget;
+    }
+
+    /**
+     * Takes {@code bytes} out of the pool.
+     *
+     * @return whether there was room. Always true when no ceiling is configured.
+     */
+    public static boolean take(int bytes) {
+        if (!enabled) {
+            return true;
+        }
+
+        if (remaining < bytes) {
+            return false;
+        }
+
+        remaining -= bytes;
+        return true;
+    }
+}
diff --git a/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java b/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java
index 3918419fac70d68e8f3ebd3006560c3c1935aa29..e94d9634a86ba9e28e9de4fdfe74d84668cea0e7 100644
--- a/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java
@@ -177,6 +177,37 @@ public class VoidSoulConfig {
         public boolean asyncPlayerData = true;
     }
 
+    /**
+     * @return the server-wide chunk byte ceiling, or 0 when there is none. Safe to call
+     *         before the config is loaded.
+     */
+    public static int getChunkSendBytesPerTick() {
+        return config == null || config.chunkSending == null ? 0 : config.chunkSending.maxBytesPerTick;
+    }
+
+    @Comment("Server-wide ceiling on chunk sending, on top of the per-player budget in\n" +
+            "each world's chunks.send section.")
+    public ChunkSendingConfig chunkSending = new ChunkSendingConfig();
+
+    @ConfigSerializable
+    public static class ChunkSendingConfig {
+        @Comment("Maximum number of bytes of chunk data the whole server may send per tick,\n" +
+                "across every player.\n" +
+                "\n" +
+                "This is a safety ceiling for the case the per-player budget cannot cover:\n" +
+                "two hundred players joining at once, each individually within its budget.\n" +
+                "\n" +
+                "Be aware of what it does when it binds. The budget is spent in player list\n" +
+                "order, so once it runs out the players near the end of the list wait for the\n" +
+                "next tick - the same players every tick. That is acceptable as a ceiling\n" +
+                "that almost never triggers and unacceptable as a routine limit, which is why\n" +
+                "it is off by default and the per-player budget is the one meant to do the\n" +
+                "work. If you enable it, set it well above (players x per-player budget) for\n" +
+                "a normal join rate.\n" +
+                "0 disables it.")
+        public int maxBytesPerTick = 0;
+    }
+
     @Comment("Built-in performance measurement, read with /vs perf.")
     public DebugConfig debug = new DebugConfig();
 
