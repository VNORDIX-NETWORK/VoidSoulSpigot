diff --git a/src/main/java/net/minecraft/server/EntityPlayer.java b/src/main/java/net/minecraft/server/EntityPlayer.java
index 0a01f5c7ceb3bd539e1f279816d27e18b8f892f8..2e0ae5915bcf5db2a2529449ff53864d7ce74ee3 100644
--- a/src/main/java/net/minecraft/server/EntityPlayer.java
+++ b/src/main/java/net/minecraft/server/EntityPlayer.java
@@ -250,14 +250,42 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
 
             Chunk chunk;
 
-            while (iterator1.hasNext() && arraylist.size() < this.world.spigotConfig.maxBulkChunk) { // Spigot
+            // VoidSoulSpigot start - chunk send budget
+            com.voidsoul.spigot.config.VoidSoulWorldConfig.ChunksConfig.SendConfig sendConfig = this.world.voidsoulConfig.chunks.send;
+            int maxChunks = sendConfig.maxChunksPerTick > 0 ? sendConfig.maxChunksPerTick : this.world.spigotConfig.maxBulkChunk;
+            int byteBudget = sendConfig.maxBytesPerTick;
+            // VoidSoulSpigot end
+
+            while (iterator1.hasNext() && arraylist.size() < maxChunks) { // Spigot // VoidSoulSpigot - configurable chunk limit
                 ChunkCoordIntPair chunkcoordintpair = (ChunkCoordIntPair) iterator1.next();
 
                 if (chunkcoordintpair != null) {
                     if (this.world.isLoaded(new BlockPosition(chunkcoordintpair.x << 4, 0, chunkcoordintpair.z << 4))) {
                         chunk = this.world.getChunkAt(chunkcoordintpair.x, chunkcoordintpair.z);
                         if (chunk.isReady()) {
-                            voidsoulBytes += chunk.getChunkMapSize(); // VoidSoulSpigot - internal profiler
+                            // VoidSoulSpigot start - chunk send budget: a chunk's payload
+                            // size is known from its section count without building it, so
+                            // stopping here costs nothing. The first chunk always goes
+                            // through, otherwise a chunk bigger than the whole budget would
+                            // never be sent and the player's queue would never drain.
+                            int chunkBytes = chunk.getChunkMapSize();
+
+                            if (!arraylist.isEmpty()) {
+                                if (byteBudget > 0 && voidsoulBytes + chunkBytes > byteBudget) {
+                                    this.world.voidsoulStats.chunkSendsDeferred.increment();
+                                    break;
+                                }
+
+                                if (!com.voidsoul.spigot.chunk.ChunkSendBudget.take(chunkBytes)) {
+                                    this.world.voidsoulStats.chunkSendsDeferred.increment();
+                                    break;
+                                }
+                            } else {
+                                com.voidsoul.spigot.chunk.ChunkSendBudget.take(chunkBytes);
+                            }
+
+                            voidsoulBytes += chunkBytes;
+                            // VoidSoulSpigot end
                             arraylist.add(chunk);
                             arraylist1.addAll(chunk.tileEntities.values()); // CraftBukkit - Get tile entities directly from the chunk instead of the world
                             iterator1.remove();
