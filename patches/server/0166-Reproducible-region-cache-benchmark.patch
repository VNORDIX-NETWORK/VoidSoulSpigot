From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Velez Garcia <velezgarciaemmanuel25@gmail.com>
Date: Wed, 2 Sep 2026 13:05:00 -0500
Subject: [PATCH] Reproducible region cache benchmark

The audit gates the region locking work behind a production baseline, and
a production baseline needs players. This is the part that does not.

/vs bench regioncache [files] [passes] drives RegionFileCache directly
against throwaway files in a temporary directory, so open, evict and
reopen behaviour can be measured on any machine, before and after a
change, with nothing else moving. It reports a cold sweep, a working-set
sweep, and reopens per pass - which is the number that says whether the
cache is being evicted from or emptied.

It measures the cache policy, not disk throughput of real chunks: no
chunk data is read or written, because mixing in terrain generation would
bury the signal under run-to-run noise. It refuses to run with players
online unless "force" is appended, since it blocks the server for
seconds, and it closes only the handles it opened rather than calling
RegionFileCache.a(), which would have reopened every real world's region
files as a side effect of a benchmark.

Two counters back it and are useful on their own, so /vs perf chunks now
reports region files opened and evicted, with a note when evictions
approach opens - the signature of more worlds in play than the 256-entry
cache holds.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/com/voidsoul/spigot/bench/RegionCacheBenchmark.java b/src/main/java/com/voidsoul/spigot/bench/RegionCacheBenchmark.java
new file mode 100644
index 0000000000000000000000000000000000000000..37475d71005995b44497c4168595935d4afc65f0
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/bench/RegionCacheBenchmark.java
@@ -0,0 +1,188 @@
+package com.voidsoul.spigot.bench;
+
+import com.voidsoul.spigot.perf.VoidSoulProfiler;
+import net.minecraft.server.RegionFile;
+import net.minecraft.server.RegionFileCache;
+
+import java.io.File;
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.Map;
+
+/**
+ * A reproducible benchmark of the region file cache.
+ * <p>
+ * The audit gates the region locking work behind a production baseline, and a production
+ * baseline needs players. This is the part that does not: it drives {@link RegionFileCache}
+ * directly against throwaway files in a temporary directory, so the open, evict and reopen
+ * behaviour can be measured on any machine, before and after a change, with nothing else
+ * moving.
+ * <p>
+ * It measures the cache policy, not disk throughput of real chunks - no chunk data is read
+ * or written. That is the point: the policy is what changed, and mixing in terrain
+ * generation would bury the signal under noise that varies run to run.
+ * <p>
+ * Main thread only, and it blocks for as long as it runs.
+ */
+public final class RegionCacheBenchmark {
+    /** The cache's ceiling. Kept in step with RegionFileCache's own limit. */
+    private static final int CACHE_CEILING = 256;
+
+    private RegionCacheBenchmark() {
+    }
+
+    /** What one run produced. All times in milliseconds. */
+    public static final class Result {
+        public final int files;
+        public final int passes;
+        public final double coldMillis;
+        public final double workingSetMillis;
+        public final long opens;
+        public final long evictions;
+        public final double slowestOpenMillis;
+
+        Result(int files, int passes, double coldMillis, double workingSetMillis,
+               long opens, long evictions, double slowestOpenMillis) {
+            this.files = files;
+            this.passes = passes;
+            this.coldMillis = coldMillis;
+            this.workingSetMillis = workingSetMillis;
+            this.opens = opens;
+            this.evictions = evictions;
+            this.slowestOpenMillis = slowestOpenMillis;
+        }
+
+        /**
+         * Reopens per pass over the working set. Under an LRU that holds the working set,
+         * this sits near 1 - the one new file each pass touches. Under a policy that clears
+         * the whole cache it spikes to the size of the working set, because everything has
+         * to be opened again.
+         */
+        public double reopensPerPass() {
+            return this.passes == 0 ? 0.0D : (double) this.opens / this.passes;
+        }
+    }
+
+    /**
+     * Runs the benchmark.
+     *
+     * @param scratch directory to create the throwaway region files in; created if missing
+     * @param files   how many distinct region files to touch. Above the cache ceiling of
+     *                256 the eviction policy starts to matter, which is the interesting
+     *                part, so a useful figure is comfortably above it
+     * @param passes  how many times to sweep a working set that fits inside the cache
+     */
+    public static Result run(File scratch, int files, int passes) throws Exception {
+        if (!scratch.isDirectory() && !scratch.mkdirs()) {
+            throw new IllegalStateException("Could not create " + scratch);
+        }
+
+        long opensBefore = VoidSoulProfiler.regionFileOpens.total();
+        long evictionsBefore = VoidSoulProfiler.regionFileEvictions.total();
+
+        try {
+            // Phase A - cold: touch every file once, from nothing cached. Past the ceiling
+            // this is where eviction starts happening, so it prices the eviction path.
+            long[] openNanos = new long[files];
+            long coldStart = System.nanoTime();
+
+            for (int i = 0; i < files; i++) {
+                long one = System.nanoTime();
+                RegionFileCache.a(scratch, i * 32, 0, true);
+                openNanos[i] = System.nanoTime() - one;
+            }
+
+            double coldMillis = (System.nanoTime() - coldStart) / 1_000_000.0D;
+
+            // Phase B - working set: sweep a set that comfortably fits in the cache, and
+            // touch one file outside it per pass. This is the shape of a real server with
+            // more worlds than the cache holds, and it is exactly where a clear-everything
+            // policy falls over: one insert past the ceiling used to drop all 256 entries,
+            // so the next sweep reopened the entire working set.
+            int workingSet = Math.min(files, CACHE_CEILING - 8);
+            long warmStart = System.nanoTime();
+
+            for (int pass = 0; pass < passes; pass++) {
+                for (int i = 0; i < workingSet; i++) {
+                    RegionFileCache.a(scratch, i * 32, 0, true);
+                }
+
+                // One file the working set does not contain, to push against the ceiling.
+                RegionFileCache.a(scratch, (CACHE_CEILING + pass) * 32, 0, true);
+            }
+
+            double warmMillis = (System.nanoTime() - warmStart) / 1_000_000.0D;
+
+            Arrays.sort(openNanos);
+
+            return new Result(
+                    files,
+                    passes,
+                    coldMillis,
+                    warmMillis,
+                    VoidSoulProfiler.regionFileOpens.total() - opensBefore,
+                    VoidSoulProfiler.regionFileEvictions.total() - evictionsBefore,
+                    files == 0 ? 0.0D : openNanos[files - 1] / 1_000_000.0D);
+        } finally {
+            // Close only the handles this run opened, then delete the files under them.
+            // RegionFileCache.a() would have been shorter and would also have closed every
+            // real world's region files, turning a benchmark into a server-wide reopen.
+            closeUnder(scratch);
+            delete(scratch);
+        }
+    }
+
+    /**
+     * Drops this run's entries from the shared cache.
+     * <p>
+     * Taken under the same monitor {@code RegionFileCache}'s own static synchronized methods
+     * use, because the map is shared with every world and with the chunk I/O threads.
+     */
+    private static void closeUnder(File scratch) {
+        String prefix = scratch.getAbsolutePath();
+
+        synchronized (RegionFileCache.class) {
+            Iterator<Map.Entry<File, RegionFile>> iterator = RegionFileCache.a.entrySet().iterator();
+
+            while (iterator.hasNext()) {
+                Map.Entry<File, RegionFile> entry = iterator.next();
+
+                if (entry.getKey().getAbsolutePath().startsWith(prefix)) {
+                    try {
+                        entry.getValue().c();
+                    } catch (Exception ignored) {
+                        // Closing a throwaway file; nothing here is worth failing the run.
+                    }
+
+                    iterator.remove();
+                }
+            }
+        }
+    }
+
+    /**
+     * Reopens counted during phase B only, which is the number the cache policy actually
+     * decides. Phase A's opens are unavoidable - the files did not exist yet.
+     */
+    public static long workingSetOpens(Result result) {
+        return Math.max(0L, result.opens - result.files);
+    }
+
+    private static void delete(File directory) {
+        File[] children = directory.listFiles();
+
+        if (children != null) {
+            for (File child : children) {
+                if (child.isDirectory()) {
+                    delete(child);
+                } else if (!child.delete()) {
+                    child.deleteOnExit();
+                }
+            }
+        }
+
+        if (!directory.delete()) {
+            directory.deleteOnExit();
+        }
+    }
+}
