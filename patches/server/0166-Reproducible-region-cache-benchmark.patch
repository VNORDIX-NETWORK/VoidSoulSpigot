     }
 
+    // VoidSoulSpigot start - reproducible benchmarks
+    /** {@code /vs bench regioncache [files] [passes] [force]} */
+    private boolean bench(CommandSender sender, String[] args) {
+        if (args.length < 2 || !args[1].equalsIgnoreCase("regioncache")) {
+            sender.sendMessage(ChatColor.RED + "Usage: /vs bench regioncache [files] [passes]");
+            sender.sendMessage(LABEL + "Drives the region file cache against throwaway files so "
+                    + "its open and evict behaviour can be compared across builds. It blocks "
+                    + "the server while it runs.");
+            return true;
+        }
+
+        int files = parse(args, 2, 1024, 8, 20000);
+        int passes = parse(args, 3, 40, 1, 2000);
+        boolean force = args.length > 4 && args[4].equalsIgnoreCase("force");
+        int online = MinecraftServer.getServer().getPlayerList().getPlayerCount();
+
+        if (online > 0 && !force) {
+            sender.sendMessage(ChatColor.RED + "There are " + online + " players online and this "
+                    + "freezes the server for seconds. Run it on an empty server, or append "
+                    + ChatColor.WHITE + "force" + ChatColor.RED + " if you mean it.");
+            return true;
+        }
+
+        File scratch = new File(MinecraftServer.getServer().server.getWorldContainer(), "voidsoul-bench");
+
+        sender.sendMessage(LABEL + "Running: " + files + " region files, " + passes + " passes...");
+
+        RegionCacheBenchmark.Result result;
+
+        try {
+            result = RegionCacheBenchmark.run(scratch, files, passes);
+        } catch (Throwable throwable) {
+            sender.sendMessage(ChatColor.RED + "Benchmark failed: " + throwable);
+            MinecraftServer.LOGGER.warn("VoidSoul region cache benchmark failed", throwable);
+            return true;
+        }
+
+        header(sender, "Region cache benchmark");
+        line(sender, "Files", result.files + "" + LABEL + " distinct, cache ceiling 256");
+        line(sender, "Cold sweep", String.format("%.1f ms", result.coldMillis) + LABEL
+                + "  slowest single open " + VALUE + String.format("%.2f ms", result.slowestOpenMillis));
+        line(sender, "Working set", String.format("%.1f ms over %d passes",
+                result.workingSetMillis, result.passes));
+        line(sender, "Opens", result.opens + "" + LABEL + "  evictions " + VALUE + result.evictions);
+        line(sender, "Reopens/pass", String.format("%.1f",
+                (double) RegionCacheBenchmark.workingSetOpens(result) / Math.max(1, result.passes)));
+        sender.sendMessage(LABEL + "Reopens per pass near 1 means the working set stayed cached. "
+                + "A figure near the working set size means the cache is being emptied rather "
+                + "than evicted from.");
+        footer(sender);
+        return true;
+    }
+
+    private static int parse(String[] args, int index, int fallback, int min, int max) {
+        if (args.length <= index) {
+            return fallback;
+        }
+
+        try {
+            return Math.max(min, Math.min(max, Integer.parseInt(args[index])));
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+    // VoidSoulSpigot end
+
     private void trace(CommandSender sender, String argument) {
         if (argument.equals("on") || argument.equals("off")) {
             boolean on = argument.equals("on");
