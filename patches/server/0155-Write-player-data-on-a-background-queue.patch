diff --git a/src/main/java/com/voidsoul/spigot/io/AsyncSaveQueue.java b/src/main/java/com/voidsoul/spigot/io/AsyncSaveQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..19f3d5f78690dcc558936d485d302aea9b2cd15c
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/io/AsyncSaveQueue.java
@@ -0,0 +1,167 @@
+package com.voidsoul.spigot.io;
+
+import net.minecraft.server.NBTCompressedStreamTools;
+import net.minecraft.server.NBTTagCompound;
+import org.bukkit.Bukkit;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.OutputStream;
+import java.util.Map;
+import java.util.concurrent.BlockingQueue;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Write queue that moves NBT files off the main thread.
+ * <p>
+ * Player data is saved for every online player in a single tick on every autosave, which
+ * on a busy server means hundreds of blocking file writes back to back. Serialising the
+ * data still happens on the main thread, because reading entity state from anywhere else
+ * is not safe; only the write itself is handed over.
+ * <p>
+ * A single writer thread keeps writes for the same file in the order they were submitted,
+ * so a later save can never be overwritten by an earlier one. Data waiting in the queue is
+ * readable through {@link #peek(String)}, so a player who reconnects before their save has
+ * been flushed still gets their newest inventory rather than what is on disk.
+ */
+public final class AsyncSaveQueue {
+    private static final BlockingQueue<Job> QUEUE = new LinkedBlockingQueue<Job>();
+    private static final Map<String, NBTTagCompound> PENDING = new ConcurrentHashMap<String, NBTTagCompound>();
+    private static final AtomicInteger IN_FLIGHT = new AtomicInteger();
+    private static volatile Thread writer;
+
+    private AsyncSaveQueue() {
+    }
+
+    private static final class Job {
+        final String key;
+        final NBTTagCompound data;
+        final File target;
+
+        Job(String key, NBTTagCompound data, File target) {
+            this.key = key;
+            this.data = data;
+            this.target = target;
+        }
+    }
+
+    private static synchronized void ensureStarted() {
+        if (writer != null) {
+            return;
+        }
+
+        Thread thread = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                while (true) {
+                    Job job;
+
+                    try {
+                        job = QUEUE.take();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        return;
+                    }
+
+                    try {
+                        write(job.data, job.target);
+                    } catch (Exception e) {
+                        Bukkit.getLogger().warning("Failed to save " + job.target.getName() + ": " + e);
+                    } finally {
+                        // Only clear the pending entry if a newer save has not replaced it.
+                        PENDING.remove(job.key, job.data);
+                        IN_FLIGHT.decrementAndGet();
+                    }
+                }
+            }
+        }, "VoidSoul Save Queue");
+
+        thread.setDaemon(true);
+        thread.setPriority(Thread.NORM_PRIORITY - 1);
+        thread.start();
+        writer = thread;
+    }
+
+    /**
+     * Queues an NBT compound to be written.
+     *
+     * @param key    identifies what is being written, so a pending write can be read back
+     * @param data   the compound to write, which must not be modified after this call
+     * @param target the destination file
+     */
+    public static void submit(String key, NBTTagCompound data, File target) {
+        ensureStarted();
+        PENDING.put(key, data);
+        IN_FLIGHT.incrementAndGet();
+
+        if (!QUEUE.offer(new Job(key, data, target))) {
+            // Unbounded queue, so this should not happen; write inline rather than lose data.
+            IN_FLIGHT.decrementAndGet();
+            PENDING.remove(key, data);
+            writeOrWarn(data, target);
+        }
+    }
+
+    /**
+     * @return data that has been submitted but not written yet, or null
+     */
+    public static NBTTagCompound peek(String key) {
+        return PENDING.get(key);
+    }
+
+    /**
+     * Blocks until every queued write has finished. Called before the server stops so a
+     * shutdown can never drop data.
+     */
+    public static void flush() {
+        if (writer == null) {
+            return;
+        }
+
+        long deadline = System.currentTimeMillis() + 60000L;
+
+        while (IN_FLIGHT.get() > 0 && System.currentTimeMillis() < deadline) {
+            try {
+                Thread.sleep(5L);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+
+        int remaining = IN_FLIGHT.get();
+        if (remaining > 0) {
+            Bukkit.getLogger().warning("Timed out waiting for " + remaining + " queued saves to finish.");
+        }
+    }
+
+    private static void writeOrWarn(NBTTagCompound data, File target) {
+        try {
+            write(data, target);
+        } catch (Exception e) {
+            Bukkit.getLogger().warning("Failed to save " + target.getName() + ": " + e);
+        }
+    }
+
+    /** Writes to a temporary file first, then swaps it in, so a crash mid-write can't truncate the real file. */
+    private static void write(NBTTagCompound data, File target) throws Exception {
+        File temp = new File(target.getParentFile(), target.getName() + ".tmp");
+        OutputStream out = new FileOutputStream(temp);
+
+        try {
+            NBTCompressedStreamTools.a(data, out);
+        } finally {
+            out.close();
+        }
+
+        if (target.exists() && !target.delete()) {
+            throw new IllegalStateException("could not replace " + target);
+        }
+
+        if (!temp.renameTo(target)) {
+            throw new IllegalStateException("could not rename " + temp + " into place");
+        }
+    }
+}
