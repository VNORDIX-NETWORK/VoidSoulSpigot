From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Velez Garcia <velezgarciaemmanuel25@gmail.com>
Date: Fri, 31 Jul 2026 19:02:11 -0500
Subject: [PATCH] Keep configuration files in a VoidSoul folder

voidsoul.yml and pandaspigot.yml now live in VoidSoul/ instead of being
scattered across the server root. A config left in the old location is
moved on startup, so an existing server keeps its settings rather than
silently regenerating defaults. Files pointed at explicitly with a command
line flag are left alone.

diff --git a/src/main/java/com/voidsoul/spigot/config/VoidSoulConfigFolder.java b/src/main/java/com/voidsoul/spigot/config/VoidSoulConfigFolder.java
new file mode 100644
index 0000000000000000000000000000000000000000..52e2c2babcd87b9952f1722866edb0d114370f54
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulConfigFolder.java
@@ -0,0 +1,57 @@
+package com.voidsoul.spigot.config;
+
+import org.bukkit.Bukkit;
+
+import java.io.File;
+
+/**
+ * VoidSoulSpigot keeps its own configuration and PandaSpigot's together in one folder
+ * instead of scattering them across the server root.
+ */
+public final class VoidSoulConfigFolder {
+    /** Name of the folder, relative to the server root. */
+    public static final String NAME = "VoidSoul";
+
+    private VoidSoulConfigFolder() {
+    }
+
+    /**
+     * Creates the configuration folder if needed, and moves a config left over in the server
+     * root into it, so a server upgrading from an earlier build keeps its settings instead of
+     * silently regenerating defaults.
+     * <p>
+     * Files pointed at explicitly with a command line flag are left alone.
+     *
+     * @param file the configuration file that is about to be loaded
+     * @return {@code file}, for convenience
+     */
+    public static File prepare(File file) {
+        File folder = file.getParentFile();
+
+        // Only touch files that actually live in our folder; anything else was chosen
+        // deliberately by the server owner with a command line flag.
+        if (folder == null || !folder.getName().equals(NAME)) {
+            return file;
+        }
+
+        if (!folder.isDirectory() && !folder.mkdirs()) {
+            Bukkit.getLogger().warning("Could not create the " + NAME + " configuration folder.");
+            return file;
+        }
+
+        if (!file.exists()) {
+            File legacy = new File(file.getName());
+
+            if (legacy.isFile()) {
+                if (legacy.renameTo(file)) {
+                    Bukkit.getLogger().info("Moved " + legacy.getName() + " into " + NAME + "/");
+                } else {
+                    Bukkit.getLogger().warning("Could not move " + legacy.getName() + " into " + NAME
+                            + "/ - it will be regenerated with default values.");
+                }
+            }
+        }
+
+        return file;
+    }
+}
