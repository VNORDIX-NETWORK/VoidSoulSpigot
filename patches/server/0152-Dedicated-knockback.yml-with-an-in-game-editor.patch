From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Velez Garcia <velezgarciaemmanuel25@gmail.com>
Date: Fri, 31 Jul 2026 21:33:06 -0500
Subject: [PATCH] Dedicated knockback.yml with an in-game editor

Knockback moves out of voidsoul.yml into VoidSoul/knockback.yml, keeping
the per-world layout so an arena can differ from the mines.

/knockback (aliases /kb) opens an editor for the world the player is
standing in. The menu is generated by reflecting over KnockbackConfig, so
it cannot drift from the config: adding a field adds a button, and the
field's comment becomes the button's description. Left and right click
step a value up and down, shift takes bigger steps, booleans toggle and
the model cycles. Every change is written to knockback.yml and applied
live. /knockback reload re-reads the file for hand edits.

Clicks are intercepted in PlayerConnection rather than through a Bukkit
listener, since the server core has no plugin to register one with.

diff --git a/src/main/java/com/voidsoul/spigot/config/KnockbackConfig.java b/src/main/java/com/voidsoul/spigot/config/KnockbackConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..7dde6018e7eb0df04c7d161f2b4e74158fd1e477
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/config/KnockbackConfig.java
@@ -0,0 +1,223 @@
+package com.voidsoul.spigot.config;
+
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+
+/**
+ * Knockback settings for one world, loaded from {@code VoidSoul/knockback.yml}.
+ * <p>
+ * These live in their own file because they are the values a server owner ends up
+ * retuning most often, and because the in-game editor ({@code /knockback}) writes back
+ * to them.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class KnockbackConfig {
+    public enum Type {
+        /** Vanilla's model: divide the current motion by a friction value, then add knockback. */
+        SIMPLE,
+        /** Knockback is sent along the attacker's facing and replaces the victim's motion. */
+        ADVANCED,
+        /** Motion is discarded and replaced with fixed values, so every hit lands the same. */
+        CONSTANT
+    }
+
+    @Comment("Which knockback model to use:\n" +
+            "  SIMPLE   - vanilla's model, tuned by the values right below. Divides the\n" +
+            "             victim's motion by \"friction\" and then adds knockback.\n" +
+            "  ADVANCED - the \"advanced\" section. Knockback is sent along the direction the\n" +
+            "             attacker is facing and replaces the victim's motion outright, so it\n" +
+            "             stays predictable no matter where the two players are standing.\n" +
+            "  CONSTANT - the \"constant\" section. Throws the victim's existing motion away\n" +
+            "             entirely, so every hit sends them the same distance no matter what\n" +
+            "             they were doing. The most predictable to combo.")
+    public Type type = Type.SIMPLE;
+
+    // ---- SIMPLE ----------------------------------------------------------------
+
+    public double friction = 2.0;
+    public double horizontal = 0.4;
+    public double vertical = 0.4;
+    public double verticalLimit = 0.4000000059604645;
+    public double extraHorizontal = 0.5;
+    public double extraVertical = 0.1;
+
+    @Comment("Multiplier applied to the attacker's motion after landing a hit that\n" +
+            "deals extra knockback (sprint hit or Knockback enchantment).\n" +
+            "Vanilla: 0.6 (lower values slow the attacker down more)")
+    public double slowdown = 0.6;
+
+    @Comment("Reduce horizontal knockback on chase hits, the way 1.7 did: the attacker and\n" +
+            "the victim are facing roughly the same way and the victim is sprinting away.\n" +
+            "Makes running someone down possible instead of punting them further ahead\n" +
+            "with every hit.")
+    public boolean enableOnePointSeven = false;
+
+    @Comment("Multiplier applied to horizontal knockback on a chase hit when\n" +
+            "enableOnePointSeven is on. Lower means the victim is pushed less.")
+    public double onePointSevenMultiplier = 0.4;
+
+    // ---- shared ----------------------------------------------------------------
+
+    @Comment("Stop the victim sprinting when they get hit. Applies to every model.")
+    public boolean cancelSprintOnHit = false;
+
+    @Comment("Multipliers applied to the velocity an entity receives when hit by a\n" +
+            "fishing rod hook. 1.0 is vanilla behaviour.")
+    public double rodHorizontalMultiplier = 1.0;
+    public double rodVerticalMultiplier = 1.0;
+
+    @Comment("Multiplier applied to the whole rod velocity vector, on top of the two\n" +
+            "values above.")
+    public double rodSpeedMultiplier = 1.0;
+
+    @Comment("Knockback applied when the victim is hit by an arrow.")
+    public BowConfig bow = new BowConfig();
+
+    @Comment("Settings for the ADVANCED model. Only read when type is ADVANCED.")
+    public AdvancedConfig advanced = new AdvancedConfig();
+
+    @Comment("Settings for the CONSTANT model. Only read when type is CONSTANT.")
+    public ConstantConfig constant = new ConstantConfig();
+
+    @Comment("Combo mode keeps a victim inside a hittable box so they can be chained,\n" +
+            "instead of floating out of reach after a few hits.\n" +
+            "Only applies to the ADVANCED model.")
+    public ComboConfig combo = new ComboConfig();
+
+    @ConfigSerializable
+    public static class BowConfig {
+        @Comment("Take arrow knockback over from vanilla.\n" +
+                "\n" +
+                "Vanilla pushes the victim away from where the SHOOTER is standing at the\n" +
+                "moment the arrow lands, not along the arrow's path. A shooter who strafes\n" +
+                "after firing therefore knocks people sideways, and an arrow you shoot at\n" +
+                "yourself sends you in a random direction, because the shooter and the\n" +
+                "victim are at the same spot and vanilla picks a random one.\n" +
+                "\n" +
+                "With this on, knockback follows the arrow's own direction of travel.")
+        public boolean enabled = true;
+
+        @Comment("Horizontal and vertical knockback applied when an arrow hits.")
+        public double horizontal = 0.9;
+        public double vertical = 0.9;
+
+        @Comment("Multiplier on the Punch enchantment's contribution:\n" +
+                "knockback *= (punchLevel * multiplier) + 1")
+        public double punchMultiplier = 1.1;
+
+        @Comment("Bow boosting is a player launching themselves with their own arrow.\n" +
+                "Only used when boostDirectional is on and the bow has Punch.")
+        public double boostHorizontal = 1.1;
+        public double boostVertical = 0.35;
+
+        @Comment("Launch along the direction the shooter was facing when they fired,\n" +
+                "instead of along the arrow's path.")
+        public boolean boostDirectional = false;
+
+        @Comment("Restrict the boost values to the player who fired the arrow. When off,\n" +
+                "anyone hit by a Punch arrow gets launched the shooter's way.")
+        public boolean boostOnlyShooter = false;
+    }
+
+    @ConfigSerializable
+    public static class AdvancedConfig {
+        public double horizontal = 0.45;
+
+        @Comment("Horizontal knockback multiplier while the victim is standing on ground.")
+        public double horizontalOnGround = 1.1;
+
+        @Comment("Horizontal knockback multiplier applied on the attacker's sprint hit.")
+        public double horizontalSprinting = 0.95;
+
+        @Comment("Keep part of the victim's existing horizontal motion instead of\n" +
+                "replacing it outright.")
+        public boolean horizontalInherit = true;
+
+        @Comment("How much of the victim's horizontal motion is kept when\n" +
+                "horizontalInherit is on. 0 keeps none, 1 keeps all of it.")
+        public double horizontalFriction = 0.35;
+
+        @Comment("Divisor applied along with the Knockback enchantment level:\n" +
+                "horizontal *= (enchantLevel + 1) / deduction\n" +
+                "Values below 1 make every hit stronger, above 1 weaker. Since an\n" +
+                "unenchanted weapon still counts as level 0, this scales normal hits too.")
+        public double horizontalKnockbackDeduction = 0.8;
+
+        public double vertical = 0.35;
+
+        @Comment("Vertical knockback multiplier while the victim is standing on ground.")
+        public double verticalOnGround = 1.1;
+
+        @Comment("Vertical knockback multiplier while the victim is airborne.")
+        public double verticalInAir = 0.85;
+
+        @Comment("Vertical knockback multiplier applied on the attacker's sprint hit.")
+        public double verticalSprinting = 1.0;
+
+        @Comment("Keep part of the victim's existing vertical motion instead of\n" +
+                "replacing it outright.")
+        public boolean verticalInherit = false;
+
+        @Comment("How much of the victim's vertical motion is kept when verticalInherit\n" +
+                "is on.")
+        public double verticalFriction = 0.35;
+
+        @Comment("Use a separate, weaker horizontal knockback on chase hits.")
+        public boolean enableOnePointSeven = true;
+
+        @Comment("Horizontal knockback used for chase hits. Replaces \"horizontal\"\n" +
+                "rather than multiplying it.")
+        public double onePointSevenHorizontal = 0.37;
+
+        @Comment("Kill the victim's vertical motion once they are more than verticalLimit\n" +
+                "blocks above the attacker, so they drop back into reach.")
+        public boolean enableVerticalLimit = false;
+        public double verticalLimit = 1.2;
+
+        @Comment("Multiplier applied to the attacker's own motion when they land a hit\n" +
+                "while sprinting.")
+        public double slowdown = 0.6;
+
+        @Comment("Stop the attacker sprinting after they land a sprint hit.")
+        public boolean cancelSprint = true;
+    }
+
+    @ConfigSerializable
+    public static class ConstantConfig {
+        public double horizontal = 0.527375;
+        public double vertical = 0.361375;
+
+        @Comment("Vertical knockback used once the victim has been off the ground for\n" +
+                "longer than 20 ticks, so players who are already flying away don't get\n" +
+                "launched further.")
+        public double verticalLongAir = 0.1;
+
+        @Comment("Horizontal knockback used when the attacker was sprinting, which is the\n" +
+                "hit that also resets their sprint.")
+        public double horizontalSprintReset = 0.8545;
+
+        @Comment("Extra horizontal knockback based on how far the victim is turned away\n" +
+                "from the attacker. 0 disables it, 1 adds up to a full extra hit's worth\n" +
+                "when they are facing directly away.")
+        public double yawModifier = 0.0;
+    }
+
+    @ConfigSerializable
+    public static class ComboConfig {
+        @Comment("Enable combo mode.")
+        public boolean enabled = false;
+
+        @Comment("How high above the attacker the victim may float before their vertical\n" +
+                "motion gets replaced, to stop them drifting out of reach mid-combo.")
+        public double height = 2.3;
+
+        @Comment("Once the victim goes over the height limit, keep forcing their vertical\n" +
+                "motion for this many ticks afterwards.")
+        public int ticks = 10;
+
+        @Comment("Vertical motion given to a victim who is being held in the combo.\n" +
+                "Negative pulls them down.")
+        public double velocity = -0.05;
+    }
+}
diff --git a/src/main/java/com/voidsoul/spigot/config/VoidSoulKnockbackConfig.java b/src/main/java/com/voidsoul/spigot/config/VoidSoulKnockbackConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..a9de7d2f74b47404c19abba3cb0df431a376f6c4
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulKnockbackConfig.java
@@ -0,0 +1,136 @@
+package com.voidsoul.spigot.config;
+
+import com.google.common.base.Throwables;
+import com.hpfxd.configurate.eoyaml.EOYamlConfigurationLoader;
+import net.minecraft.server.World;
+import org.bukkit.Bukkit;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.objectmapping.ObjectMapper;
+import org.spongepowered.configurate.util.MapFactories;
+import org.spongepowered.configurate.util.NamingSchemes;
+
+import java.io.File;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Loads and saves {@code VoidSoul/knockback.yml}, which holds the knockback settings for
+ * each world. Kept apart from {@code voidsoul.yml} because {@code /knockback} writes back
+ * to this file whenever a value is changed in game.
+ */
+public final class VoidSoulKnockbackConfig {
+    private static File file;
+    private static KnockbackConfig defaultWorldConfig;
+    private static final Map<String, KnockbackConfig> worldConfigs = new HashMap<String, KnockbackConfig>();
+
+    private VoidSoulKnockbackConfig() {
+    }
+
+    private static EOYamlConfigurationLoader loader() {
+        return EOYamlConfigurationLoader.builder()
+                .file(file)
+                .defaultOptions(o -> o
+                        .header("Knockback settings for VoidSoulSpigot.\n" +
+                                "\n" +
+                                "Every world listed under \"worlds\" gets its own knockback. The \"default\"\n" +
+                                "section provides the values for any world without its own entry, so adding\n" +
+                                "a section named after a world lets you give an arena different knockback\n" +
+                                "from the mines.\n" +
+                                "\n" +
+                                "These values can also be edited in game with /knockback, which writes the\n" +
+                                "result straight back to this file.")
+                        .mapFactory(MapFactories.insertionOrdered())
+                        .serializers(build -> build.registerAnnotatedObjects(ObjectMapper.factoryBuilder()
+                                .defaultNamingScheme(NamingSchemes.CAMEL_CASE)
+                                .build())))
+                .build();
+    }
+
+    /**
+     * Loads the configuration. Called once on startup and on every reload.
+     *
+     * @param configFile the knockback configuration file
+     */
+    public static void init(File configFile) {
+        file = configFile;
+
+        try {
+            EOYamlConfigurationLoader loader = loader();
+            CommentedConfigurationNode root = loader.load();
+
+            CommentedConfigurationNode worldsNode = root.node("worlds");
+            ConfigurationNode defaultNode = worldsNode.node("default");
+            defaultWorldConfig = defaultNode.get(KnockbackConfig.class);
+            defaultNode.set(defaultWorldConfig); // write defaults back out
+
+            loader.save(root);
+
+            worldConfigs.clear();
+            for (Map.Entry<Object, ? extends ConfigurationNode> entry : worldsNode.childrenMap().entrySet()) {
+                Object worldName = entry.getKey();
+                if (worldName.equals("default")) continue;
+
+                worldConfigs.put(worldName.toString(), entry.getValue().get(KnockbackConfig.class));
+            }
+        } catch (Exception e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
+    /**
+     * Writes the in-memory settings back to disk, keeping the comments. Used by the
+     * in-game editor after a value is changed.
+     *
+     * @return whether the file was written
+     */
+    public static boolean save() {
+        if (file == null) {
+            return false;
+        }
+
+        try {
+            EOYamlConfigurationLoader loader = loader();
+            CommentedConfigurationNode root = loader.load();
+            CommentedConfigurationNode worldsNode = root.node("worlds");
+
+            worldsNode.node("default").set(defaultWorldConfig);
+            for (Map.Entry<String, KnockbackConfig> entry : worldConfigs.entrySet()) {
+                worldsNode.node(entry.getKey()).set(entry.getValue());
+            }
+
+            loader.save(root);
+            return true;
+        } catch (Exception e) {
+            Bukkit.getLogger().warning("Could not save knockback.yml: " + e.getMessage());
+            return false;
+        }
+    }
+
+    /** Re-reads the file from disk and points every loaded world at the new settings. */
+    public static void reload() {
+        if (file != null) {
+            init(file);
+            applyToWorlds();
+        }
+    }
+
+    /**
+     * Points every loaded world at its current settings. Only needed after a reload, since
+     * edits made in game mutate the objects the worlds already hold.
+     */
+    public static void applyToWorlds() {
+        for (World world : net.minecraft.server.MinecraftServer.getServer().worlds) {
+            world.knockbackConfig = get(world.worldData.getName());
+        }
+    }
+
+    public static KnockbackConfig get(String worldName) {
+        KnockbackConfig config = worldConfigs.get(worldName);
+        return config != null ? config : defaultWorldConfig;
+    }
+
+    public static KnockbackConfig get(World world) {
+        return get(world.worldData.getName());
+    }
+}
