@@ -0,0 +1,98 @@
+package com.voidsoul.spigot.knockback;
+
+import com.voidsoul.spigot.config.VoidSoulKnockbackConfig;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * {@code /knockback} - opens the in-game knockback editor, or reloads knockback.yml.
+ */
+public final class KnockbackCommand extends Command {
+    public static final String PERMISSION = "voidsoul.command.knockback";
+
+    private KnockbackCommand() {
+        super("knockback");
+        this.description = "Edit this world's knockback settings";
+        this.usageMessage = "/knockback [world|reload]";
+        this.setPermission(PERMISSION);
+        this.setAliases(Arrays.asList("kb", "voidsoulkb"));
+    }
+
+    /** Registers the command with the server. Called once on startup. */
+    public static void register() {
+        MinecraftServer.getServer().server.getCommandMap().register("voidsoul", new KnockbackCommand());
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length > 0 && args[0].equalsIgnoreCase("reload")) {
+            VoidSoulKnockbackConfig.reload();
+            sender.sendMessage(ChatColor.GREEN + "Reloaded knockback.yml.");
+            return true;
+        }
+
+        if (!(sender instanceof Player)) {
+            sender.sendMessage(ChatColor.RED + "The knockback editor can only be opened in game. "
+                    + "Use /knockback reload from the console after editing the file by hand.");
+            return true;
+        }
+
+        Player player = (Player) sender;
+        String worldName;
+
+        if (args.length > 0) {
+            World world = Bukkit.getWorld(args[0]);
+
+            if (world == null) {
+                sender.sendMessage(ChatColor.RED + "No world named " + args[0] + ".");
+                return true;
+            }
+
+            worldName = world.getName();
+        } else {
+            worldName = player.getWorld().getName();
+        }
+
+        KnockbackMenu.open(player, worldName, "");
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (args.length != 1) {
+            return Collections.emptyList();
+        }
+
+        List<String> options = new ArrayList<String>();
+        options.add("reload");
+
+        for (World world : Bukkit.getWorlds()) {
+            options.add(world.getName());
+        }
+
+        String prefix = args[0].toLowerCase();
+        List<String> matches = new ArrayList<String>();
+
+        for (String option : options) {
+            if (option.toLowerCase().startsWith(prefix)) {
+                matches.add(option);
+            }
+        }
+
+        return matches;
+    }
+}
diff --git a/src/main/java/com/voidsoul/spigot/knockback/KnockbackMenu.java b/src/main/java/com/voidsoul/spigot/knockback/KnockbackMenu.java
new file mode 100644
index 0000000000000000000000000000000000000000..0bc567e272f6acf8b0d29d586439efb006089f68
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/knockback/KnockbackMenu.java
@@ -0,0 +1,329 @@
+package com.voidsoul.spigot.knockback;
+
+import com.voidsoul.spigot.config.KnockbackConfig;
+import com.voidsoul.spigot.config.VoidSoulKnockbackConfig;
+import org.bukkit.Bukkit;
+import org.bukkit.ChatColor;
+import org.bukkit.Material;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.Inventory;
+import org.bukkit.inventory.InventoryHolder;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.ItemMeta;
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * In-game editor for {@code knockback.yml}.
+ * <p>
+ * The menu is generated by reflecting over {@link KnockbackConfig}, so it never falls out
+ * of step with the config: adding a field to the config adds a button here, and the
+ * {@link Comment} on the field becomes the button's description.
+ */
+public final class KnockbackMenu implements InventoryHolder {
+    private static final int SIZE = 54;
+
+    private final String worldName;
+    /** Dotted path of the section being edited, empty for the top level. */
+    private final String path;
+    /** Field shown in each slot, or null for decoration. */
+    private final Field[] slots = new Field[SIZE];
+    private Inventory inventory;
+
+    private KnockbackMenu(String worldName, String path) {
+        this.worldName = worldName;
+        this.path = path;
+    }
+
+    @Override
+    public Inventory getInventory() {
+        return this.inventory;
+    }
+
+    /**
+     * Opens the editor for the world the player is standing in.
+     *
+     * @param path dotted path of the section to show, empty for the top level
+     */
+    public static void open(Player player, String worldName, String path) {
+        KnockbackMenu menu = new KnockbackMenu(worldName, path);
+        Object target = menu.resolveTarget();
+
+        if (target == null) {
+            player.sendMessage(ChatColor.RED + "That knockback section no longer exists.");
+            return;
+        }
+
+        String title = "Knockback: " + (path.isEmpty() ? worldName : path);
+        if (title.length() > 32) {
+            title = title.substring(0, 32); // 1.8 inventory titles are capped
+        }
+
+        menu.inventory = Bukkit.createInventory(menu, SIZE, title);
+        menu.render(target);
+        player.openInventory(menu.inventory);
+    }
+
+    /** Walks {@link #path} from the world's config down to the object being edited. */
+    private Object resolveTarget() {
+        Object current = VoidSoulKnockbackConfig.get(this.worldName);
+
+        if (current == null || this.path.isEmpty()) {
+            return current;
+        }
+
+        for (String part : this.path.split("\\.")) {
+            try {
+                Field field = current.getClass().getField(part);
+                current = field.get(current);
+            } catch (ReflectiveOperationException e) {
+                return null;
+            }
+
+            if (current == null) {
+                return null;
+            }
+        }
+
+        return current;
+    }
+
+    private void render(Object target) {
+        Arrays.fill(this.slots, null);
+        this.inventory.clear();
+
+        int slot = 0;
+        for (Field field : editableFields(target.getClass())) {
+            if (slot >= SIZE - 9) {
+                break; // keep the bottom row for navigation
+            }
+
+            this.slots[slot] = field;
+            this.inventory.setItem(slot, describe(field, target));
+            slot++;
+        }
+
+        if (!this.path.isEmpty()) {
+            this.inventory.setItem(SIZE - 9, item(Material.ARROW, ChatColor.YELLOW + "Back",
+                    ChatColor.GRAY + "Return to the previous screen"));
+        }
+
+        this.inventory.setItem(SIZE - 1, item(Material.BOOK, ChatColor.GREEN + "Saved automatically",
+                ChatColor.GRAY + "Every change is written to knockback.yml",
+                ChatColor.GRAY + "and applied to " + this.worldName + " immediately."));
+    }
+
+    private static List<Field> editableFields(Class<?> type) {
+        List<Field> fields = new ArrayList<Field>();
+
+        for (Field field : type.getFields()) {
+            if (Modifier.isStatic(field.getModifiers())) {
+                continue;
+            }
+
+            Class<?> fieldType = field.getType();
+            if (fieldType == double.class || fieldType == int.class || fieldType == boolean.class
+                    || fieldType.isEnum() || fieldType.isAnnotationPresent(ConfigSerializable.class)) {
+                fields.add(field);
+            }
+        }
+
+        return fields;
+    }
+
+    private ItemStack describe(Field field, Object target) {
+        Class<?> type = field.getType();
+        Object value;
+
+        try {
+            value = field.get(target);
+        } catch (IllegalAccessException e) {
+            return item(Material.BARRIER, ChatColor.RED + field.getName(), ChatColor.GRAY + "Unreadable");
+        }
+
+        List<String> lore = new ArrayList<String>();
+        Comment comment = field.getAnnotation(Comment.class);
+
+        if (comment != null) {
+            for (String line : comment.value().split("\n")) {
+                lore.add(ChatColor.GRAY + line);
+            }
+            lore.add("");
+        }
+
+        if (type.isAnnotationPresent(ConfigSerializable.class)) {
+            lore.add(ChatColor.YELLOW + "Click to open");
+            return item(Material.CHEST, ChatColor.AQUA + prettify(field.getName()), lore);
+        }
+
+        lore.add(ChatColor.WHITE + "Current: " + ChatColor.GREEN + value);
+
+        if (type == boolean.class) {
+            lore.add(ChatColor.YELLOW + "Click to toggle");
+            ItemStack stack = new ItemStack(Material.WOOL, 1, (short) (Boolean.TRUE.equals(value) ? 5 : 14));
+            return withMeta(stack, ChatColor.AQUA + prettify(field.getName()), lore);
+        }
+
+        if (type.isEnum()) {
+            lore.add(ChatColor.YELLOW + "Click to cycle");
+            return item(Material.COMPASS, ChatColor.AQUA + prettify(field.getName()), lore);
+        }
+
+        if (type == int.class) {
+            lore.add(ChatColor.YELLOW + "Left click " + ChatColor.GRAY + "+1" + ChatColor.YELLOW + "  Right click " + ChatColor.GRAY + "-1");
+            lore.add(ChatColor.YELLOW + "Hold shift for " + ChatColor.GRAY + "10");
+        } else {
+            lore.add(ChatColor.YELLOW + "Left click " + ChatColor.GRAY + "+0.05" + ChatColor.YELLOW + "  Right click " + ChatColor.GRAY + "-0.05");
+            lore.add(ChatColor.YELLOW + "Hold shift for " + ChatColor.GRAY + "0.5");
+        }
+
+        return item(Material.PAPER, ChatColor.AQUA + prettify(field.getName()), lore);
+    }
+
+    /**
+     * Intercepts a window click while a player has the editor open, so the menu never
+     * behaves like a real inventory and its items can't be taken.
+     *
+     * @param slot   raw slot from the click packet
+     * @param button mouse button, 0 for left and 1 for right
+     * @param mode   click mode from the packet
+     * @return whether the click was consumed
+     */
+    public static boolean handleClick(net.minecraft.server.EntityPlayer entityPlayer, int slot, int button, int mode) {
+        Player player = entityPlayer.getBukkitEntity();
+        Inventory top = player.getOpenInventory() != null ? player.getOpenInventory().getTopInventory() : null;
+
+        if (top == null || !(top.getHolder() instanceof KnockbackMenu)) {
+            return false;
+        }
+
+        KnockbackMenu menu = (KnockbackMenu) top.getHolder();
+
+        // Only plain left/right clicks inside the menu do anything; everything else is
+        // swallowed so items can't be dragged out.
+        if (mode == 0 && slot >= 0 && slot < top.getSize()) {
+            menu.click(player, slot, button == 1, false);
+        } else if (mode == 1 && slot >= 0 && slot < top.getSize()) {
+            menu.click(player, slot, button == 1, true);
+        }
+
+        player.updateInventory();
+        return true;
+    }
+
+    /**
+     * Applies a click.
+     *
+     * @param slag  the clicked slot within the menu
+     * @param right whether the right mouse button was used
+     * @param shift whether shift was held
+     */
+    void click(Player player, int slag, boolean right, boolean shift) {
+        Object target = this.resolveTarget();
+
+        if (target == null) {
+            player.closeInventory();
+            return;
+        }
+
+        if (slag == SIZE - 9 && !this.path.isEmpty()) {
+            int dot = this.path.lastIndexOf('.');
+            open(player, this.worldName, dot < 0 ? "" : this.path.substring(0, dot));
+            return;
+        }
+
+        Field field = slag >= 0 && slag < SIZE ? this.slots[slag] : null;
+        if (field == null) {
+            return;
+        }
+
+        Class<?> type = field.getType();
+
+        if (type.isAnnotationPresent(ConfigSerializable.class)) {
+            open(player, this.worldName, this.path.isEmpty() ? field.getName() : this.path + "." + field.getName());
+            return;
+        }
+
+        try {
+            if (type == boolean.class) {
+                field.setBoolean(target, !field.getBoolean(target));
+            } else if (type.isEnum()) {
+                Object[] constants = type.getEnumConstants();
+                int next = 0;
+                Object current = field.get(target);
+
+                for (int i = 0; i < constants.length; i++) {
+                    if (constants[i] == current) {
+                        next = right ? (i - 1 + constants.length) % constants.length : (i + 1) % constants.length;
+                        break;
+                    }
+                }
+
+                field.set(target, constants[next]);
+            } else if (type == int.class) {
+                int step = (shift ? 10 : 1) * (right ? -1 : 1);
+                field.setInt(target, field.getInt(target) + step);
+            } else {
+                double step = (shift ? 0.5D : 0.05D) * (right ? -1.0D : 1.0D);
+                // Snap to the step so repeated clicks don't accumulate float noise.
+                double updated = Math.round((field.getDouble(target) + step) * 100000.0D) / 100000.0D;
+                field.setDouble(target, updated);
+            }
+        } catch (IllegalAccessException e) {
+            player.sendMessage(ChatColor.RED + "Could not change " + field.getName() + ".");
+            return;
+        }
+
+        if (!VoidSoulKnockbackConfig.save()) {
+            player.sendMessage(ChatColor.RED + "Value changed, but knockback.yml could not be written.");
+        }
+
+        this.render(target);
+        player.updateInventory();
+    }
+
+    /** Turns a camelCase field name into something readable in a menu. */
+    private static String prettify(String name) {
+        StringBuilder out = new StringBuilder();
+
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+
+            if (i == 0) {
+                out.append(Character.toUpperCase(c));
+            } else if (Character.isUpperCase(c) && !Character.isUpperCase(name.charAt(i - 1))) {
+                out.append(' ').append(Character.toLowerCase(c));
+            } else {
+                out.append(c);
+            }
+        }
+
+        return out.toString();
+    }
+
+    private static ItemStack item(Material material, String name, String... lore) {
+        return withMeta(new ItemStack(material), name, Arrays.asList(lore));
+    }
+
+    private static ItemStack item(Material material, String name, List<String> lore) {
+        return withMeta(new ItemStack(material), name, lore);
+    }
+
+    private static ItemStack withMeta(ItemStack stack, String name, List<String> lore) {
+        ItemMeta meta = stack.getItemMeta();
+
+        if (meta != null) {
+            meta.setDisplayName(name);
+            meta.setLore(lore);
+            stack.setItemMeta(meta);
+        }
+
+        return stack;
+    }
+}
