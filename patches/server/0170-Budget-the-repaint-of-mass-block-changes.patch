@@ -191,6 +191,37 @@ public class VoidSoulWorldConfig {
             public double directionalBias = 0.35D;
         }
 
+        @Comment("How much chunk data mass block changes may repaint per tick.")
+        public DirtyFlushConfig dirtyFlush = new DirtyFlushConfig();
+
+        @ConfigSerializable
+        public static class DirtyFlushConfig {
+            @Comment("Maximum bytes of chunk data sent per tick to repaint blocks that\n" +
+                    "changed, counted across every player who receives them.\n" +
+                    "\n" +
+                    "This is the setting for mine resets and schematic pastes. Once more than\n" +
+                    "64 blocks change in a chunk, the server stops tracking individual\n" +
+                    "positions and resends whole chunk sections instead - so a reset that\n" +
+                    "touches the full height of a chunk costs a near-complete chunk packet,\n" +
+                    "for every player watching. Without a limit, every chunk a reset touched\n" +
+                    "is rebuilt, serialised and compressed inside a single tick: a hundred\n" +
+                    "chunks with ten players nearby is on the order of 170 MB of short-lived\n" +
+                    "garbage in one tick, which is what sends heap usage climbing by a\n" +
+                    "gigabyte or more until the collector catches up.\n" +
+                    "\n" +
+                    "With a budget the same work is spread over the following ticks. The mine\n" +
+                    "visibly fills in over a fraction of a second instead of appearing at\n" +
+                    "once, and the memory spike goes away. Nothing is ever lost: a chunk that\n" +
+                    "waits is sent from its state at the moment it is finally sent.\n" +
+                    "\n" +
+                    "At the default of 2 MB a hundred-chunk reset repaints in roughly half a\n" +
+                    "second. Lower it if resets still spike memory, raise it if they feel\n" +
+                    "sluggish. One chunk always goes through per tick, so a single very large\n" +
+                    "chunk can never wedge the queue. 0 disables the budget and restores the\n" +
+                    "old all-at-once behaviour.")
+            public int maxBytesPerTick = 2097152;
+        }
+
