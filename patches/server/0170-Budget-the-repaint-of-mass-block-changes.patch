+    /**
+     * Size of a partial chunk packet carrying only the sections in {@code primaryBitMask}.
+     * <p>
+     * This is the packet a mass block change turns into: past 64 changed blocks in a chunk,
+     * the server stops tracking individual positions and resends whole sections instead. A
+     * mine reset that touches the full height of a chunk therefore costs a near-complete
+     * chunk packet, per watching player - which is why the flush that sends them needs a
+     * budget, and why that budget needs the size before the packet is built.
+     *
+     * @param primaryBitMask       which sections are included
+     * @param groundUpContinuous   whether biome data rides along, as for a full send
+     */
+    public int getChunkMapSize(int primaryBitMask, boolean groundUpContinuous) {
+        int sections = 0;
+
+        for (int i = 0; i < this.sections.length; ++i) {
+            ChunkSection section = this.sections[i];
+
+            if (section != null && (primaryBitMask & (1 << i)) != 0
+                    && (!groundUpContinuous || !section.a())) {
+                ++sections;
+            }
+        }
+
+        return PacketPlayOutMapChunk.a(sections, !this.world.worldProvider.o(), groundUpContinuous);
+    }
     // VoidSoulSpigot end
 
     public PacketPlayOutMapChunk.ChunkMap getChunkMap(boolean groundUpContinuous, int primaryBitMask) {
