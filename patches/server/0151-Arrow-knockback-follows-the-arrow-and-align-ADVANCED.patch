@@ -23,6 +23,58 @@ public class EntityArrow extends Entity implements IProjectile {
     private int as;
     private double damage = 2.0D;
     public int knockbackStrength;
+    private float shooterYaw; // VoidSoulSpigot - the shooter's yaw when the arrow was fired
+
+    // VoidSoulSpigot start - arrow knockback follows the arrow, not the shooter
+    /**
+     * Replaces the knockback vanilla applied from the shooter's position with knockback
+     * along this arrow's own direction of travel.
+     * <p>
+     * Vanilla derives arrow knockback from where the shooter happens to be standing when
+     * the arrow lands, which sends the victim sideways whenever the shooter has moved
+     * since firing, and in a random direction when a player shoots themselves.
+     *
+     * @param victim the entity that was hit
+     * @return whether knockback was applied here, so the caller skips the vanilla path
+     */
+    private boolean applyConfiguredKnockback(Entity victim) {
+        com.voidsoul.spigot.config.VoidSoulWorldConfig.BowConfig bow = this.world.voidsoulConfig.knockback.bow;
+
+        if (bow == null || !bow.enabled || !(this.shooter instanceof EntityHuman)) {
+            return false;
+        }
+
+        // Punch contributes on top of the base knockback; level 0 leaves it at 1.
+        double punch = (double) this.knockbackStrength * bow.punchMultiplier + 1.0D;
+        boolean boosting = this.knockbackStrength > 0 && bow.boostDirectional
+                && (!bow.boostOnlyShooter || this.shooter == victim);
+
+        if (boosting) {
+            // Launch along the direction the shooter was facing when they fired.
+            victim.motX = -MathHelper.sin(this.shooterYaw * 3.1415927F / 180.0F) * punch * bow.boostHorizontal;
+            victim.motY = bow.boostVertical;
+            victim.motZ = MathHelper.cos(this.shooterYaw * 3.1415927F / 180.0F) * punch * bow.boostHorizontal;
+        } else {
+            double speed = Math.sqrt(this.motX * this.motX + this.motY * this.motY + this.motZ * this.motZ);
+
+            if (speed <= 0.0D) {
+                return false;
+            }
+
+            double horizontal = bow.horizontal;
+            if (this.knockbackStrength > 0) {
+                horizontal *= punch;
+            }
+
+            victim.motX = this.motX / speed / 1.6D * horizontal;
+            victim.motY = 0.36D * bow.vertical;
+            victim.motZ = this.motZ / speed / 1.6D * horizontal;
+        }
+
+        victim.velocityChanged = true;
+        return true;
+    }
+    // VoidSoulSpigot end
 
     // Spigot Start
     @Override
@@ -53,6 +105,7 @@ public class EntityArrow extends Entity implements IProjectile {
         super(world);
         this.j = 10.0D;
