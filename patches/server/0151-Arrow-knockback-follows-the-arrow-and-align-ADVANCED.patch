+    // VoidSoulSpigot start - ADVANCED knockback model
+    /** Set when this player starts sprinting, consumed by the first hit they land. */
+    private boolean shouldDealSprintKnockback;
+    /** Tick a victim was last pushed back down by combo mode. */
+    private int comboDownTick;
+
+    @Override
+    public void setSprinting(boolean flag) {
+        if (flag) {
+            if (!this.isSprinting()) {
+                this.shouldDealSprintKnockback = true;
+            }
+        } else {
+            this.shouldDealSprintKnockback = false;
+        }
+
+        super.setSprinting(flag);
+    }
+
+    /**
+     * Replaces the victim's motion outright, rather than adding to it the way vanilla does.
+     * <p>
+     * Knockback is sent along the direction the attacker is facing, so it stays predictable
+     * no matter where the two players happen to be standing, and every stage of the
+     * calculation is a separate multiplier that can be tuned on its own.
+     *
+     * @param enchantLevel the attacker's Knockback enchantment level
+     */
+    private void applyAdvancedKnockback(com.voidsoul.spigot.config.VoidSoulWorldConfig.KnockbackConfig kb, EntityLiving victim, int enchantLevel) {
+        com.voidsoul.spigot.config.VoidSoulWorldConfig.AdvancedConfig config = kb.advanced;
+
+        double facingX = Math.sin(Math.toRadians(this.yaw)) * -1.0D;
+        double facingZ = Math.cos(Math.toRadians(this.yaw));
+
+        if (config.horizontalInherit) {
+            victim.motX = victim.motX * config.horizontalFriction + facingX;
+            victim.motZ = victim.motZ * config.horizontalFriction + facingZ;
+        } else {
+            victim.motX = facingX;
+            victim.motZ = facingZ;
+        }
+
+        double horizontal = config.enableOnePointSeven && victim.isChaseHit(this)
+                ? config.onePointSevenHorizontal
+                : config.horizontal;
+        victim.motX *= horizontal;
+        victim.motZ *= horizontal;
+
+        victim.motY = config.verticalInherit
+                ? victim.motY * config.verticalFriction + config.vertical
+                : config.vertical;
+
+        if (victim.onGround) {
+            victim.motX *= config.horizontalOnGround;
+            victim.motY *= config.verticalOnGround;
+            victim.motZ *= config.horizontalOnGround;
+        } else {
+            victim.motY *= config.verticalInAir;
+        }
+
+        int levels = enchantLevel + 1;
+        if (levels > 0 && config.horizontalKnockbackDeduction != 0.0D) {
+            victim.motX = victim.motX * levels / config.horizontalKnockbackDeduction;
+            victim.motZ = victim.motZ * levels / config.horizontalKnockbackDeduction;
+        }
+
+        if (this.shouldDealSprintKnockback) {
+            victim.motX *= config.horizontalSprinting;
+            victim.motY *= config.verticalSprinting;
+            victim.motZ *= config.horizontalSprinting;
+            this.shouldDealSprintKnockback = false;
+        }
+
+        if (this.isSprinting()) {
+            this.motX *= config.slowdown;
+            this.motZ *= config.slowdown;
+            this.shouldDealSprintKnockback = false;
+
+            if (config.cancelSprint) {
+                this.setSprinting(false);
+            }
+        }
+
+        double heightAbove = victim.locY - this.locY;
+        com.voidsoul.spigot.config.VoidSoulWorldConfig.ComboConfig combo = kb.combo;
+
+        if (combo != null && combo.enabled) {
+            if (heightAbove > combo.height) {
+                this.comboDownTick = MinecraftServer.currentTick;
+            }
+
+            if (heightAbove > combo.height || MinecraftServer.currentTick - this.comboDownTick < combo.ticks) {
+                victim.motY = combo.velocity;
+            }
+        }
+
+        if (config.enableVerticalLimit && heightAbove > config.verticalLimit) {
+            victim.motY = 0.0D;
+        }
+
+        victim.velocityChanged = true;
+    }
+    // VoidSoulSpigot end
