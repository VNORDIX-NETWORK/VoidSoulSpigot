-            if (option.toLowerCase().startsWith(prefix)) {
+            if (option.toLowerCase().startsWith(lower)) {
                 matches.add(option);
             }
         }
 
         return matches;
     }
+    // VoidSoulSpigot end
 }
diff --git a/src/main/java/com/voidsoul/spigot/knockback/KnockbackProfiles.java b/src/main/java/com/voidsoul/spigot/knockback/KnockbackProfiles.java
new file mode 100644
index 0000000000000000000000000000000000000000..c048f94fbbc3d9959cd551dd2d2d0c38c20b564f
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/knockback/KnockbackProfiles.java
@@ -0,0 +1,140 @@
+package com.voidsoul.spigot.knockback;
+
+import com.voidsoul.spigot.config.KnockbackConfig;
+
+/**
+ * Named starting points for a world's knockback.
+ * <p>
+ * A profile is applied once and then written to knockback.yml like any hand-typed value, so
+ * it is a starting point you tune from, not a mode the server keeps enforcing. That is
+ * deliberate: the in-game editor writes to the same file, and a profile that re-asserted
+ * itself would silently undo whatever was tuned afterwards.
+ * <p>
+ * These numbers are opinionated, not measured. They are built out of the knobs this fork
+ * already has, and they are chosen to be recognisable starting points for each style of
+ * server - not reproductions of any particular network's feel. Expect to tune them.
+ */
+public enum KnockbackProfiles {
+
+    /** Vanilla 1.8, untouched. Applying this is how you get back to a clean slate. */
+    DEFAULT("Vanilla 1.8 knockback, exactly as Mojang shipped it.") {
+        @Override
+        void configure(KnockbackConfig config) {
+            // Every field already defaults to vanilla, so there is nothing to change.
+        }
+    },
+
+    /**
+     * Grounded fights where running someone down has to be possible. The 1.7 chase
+     * reduction is the point of this profile.
+     */
+    HCF("Grounded fights, and chasing works. Lower launch, 1.7-style chase reduction.") {
+        @Override
+        void configure(KnockbackConfig config) {
+            config.type = KnockbackConfig.Type.SIMPLE;
+            config.friction = 2.0D;
+            config.horizontal = 0.36D;
+            config.vertical = 0.36D;
+            config.verticalLimit = 0.36D;
+            config.extraHorizontal = 0.45D;
+            config.extraVertical = 0.08D;
+
+            // Without this, every hit on a fleeing player punts them further ahead and a
+            // chase can never be closed.
+            config.enableOnePointSeven = true;
+            config.onePointSevenMultiplier = 0.4D;
+        }
+    },
+
+    /**
+     * Every hit sends the victim the same distance regardless of what they were doing,
+     * which is what makes combos learnable and duels repeatable.
+     */
+    PRACTICE("Identical knockback on every hit, so combos are repeatable.") {
+        @Override
+        void configure(KnockbackConfig config) {
+            config.type = KnockbackConfig.Type.CONSTANT;
+            config.constant.horizontal = 0.527375D;
+            config.constant.vertical = 0.361375D;
+            config.constant.verticalLongAir = 0.1D;
+            config.constant.horizontalSprintReset = 0.8545D;
+            config.constant.yawModifier = 0.0D;
+            config.cancelSprintOnHit = false;
+        }
+    },
+
+    /** More air time, so healing under pressure is harder and rods matter. */
+    POT("More vertical and more air time. Rods and pearls carry the fight.") {
+        @Override
+        void configure(KnockbackConfig config) {
+            config.type = KnockbackConfig.Type.SIMPLE;
+            config.friction = 2.0D;
+            config.horizontal = 0.4D;
+            config.vertical = 0.44D;
+            config.verticalLimit = 0.44D;
+            config.extraHorizontal = 0.5D;
+            config.extraVertical = 0.14D;
+            config.rodHorizontalMultiplier = 1.1D;
+            config.rodVerticalMultiplier = 1.1D;
+        }
+    },
+
+    /**
+     * Heavy gear, long fights, tight combos. Knockback is cut so that armoured players
+     * stay in reach of each other instead of being launched apart.
+     */
+    OP("Short knockback and combo hold, for heavily geared fights.") {
+        @Override
+        void configure(KnockbackConfig config) {
+            config.type = KnockbackConfig.Type.CONSTANT;
+            config.constant.horizontal = 0.42D;
+            config.constant.vertical = 0.30D;
+            config.constant.verticalLongAir = 0.08D;
+            config.constant.horizontalSprintReset = 0.66D;
+
+            // Stops a victim drifting up and out of reach halfway through a combo.
+            config.combo.enabled = true;
+            config.combo.height = 2.3D;
+            config.combo.ticks = 10;
+            config.combo.velocity = -0.05D;
+        }
+    };
+
+    private final String summary;
+
+    KnockbackProfiles(String summary) {
+        this.summary = summary;
+    }
+
+    /** One line describing what this profile is for, shown by the command. */
+    public String summary() {
+        return this.summary;
+    }
+
+    abstract void configure(KnockbackConfig config);
+
+    /**
+     * Builds a fresh configuration for this profile.
+     * <p>
+     * A new {@link KnockbackConfig} starts at vanilla on every field, including the nested
+     * sections, and the profile then changes only what it cares about. Building rather than
+     * editing in place is what keeps a profile a clean slate: applying one discards whatever
+     * that world had before, which is what "apply a profile" should mean.
+     */
+    public KnockbackConfig build() {
+        KnockbackConfig config = new KnockbackConfig();
+        this.configure(config);
+        return config;
+    }
+
+    /** @return the profile with this name, ignoring case, or null. */
+    public static KnockbackProfiles byName(String name) {
+        for (KnockbackProfiles profile : values()) {
+            if (profile.name().equalsIgnoreCase(name)) {
+                return profile;
+            }
+        }
+
+        return null;
+    }
+}
