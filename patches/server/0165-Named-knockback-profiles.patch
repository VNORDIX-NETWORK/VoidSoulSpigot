+    // VoidSoulSpigot start - named profiles
+    /** {@code /knockback profile [name] [world]} */
+    private boolean profile(CommandSender sender, String[] args) {
+        if (args.length < 2) {
+            sender.sendMessage(ChatColor.AQUA + "Knockback profiles");
+
+            for (KnockbackProfiles profile : KnockbackProfiles.values()) {
+                sender.sendMessage(ChatColor.WHITE + "  " + profile.name() + ChatColor.GRAY
+                        + " - " + profile.summary());
+            }
+
+            sender.sendMessage(ChatColor.DARK_GRAY + "/knockback profile <name> [world|default]");
+            sender.sendMessage(ChatColor.GRAY + "Applying one replaces that world's settings "
+                    + "and writes them to knockback.yml. Tune from there with /knockback.");
+            return true;
+        }
+
+        KnockbackProfiles profile = KnockbackProfiles.byName(args[1]);
+
+        if (profile == null) {
+            sender.sendMessage(ChatColor.RED + "No profile called " + args[1]
+                    + ". Run /knockback profile to list them.");
+            return true;
+        }
+
+        String worldName;
+
+        if (args.length > 2) {
+            if (args[2].equalsIgnoreCase("default")) {
+                worldName = "default";
+            } else {
+                World world = Bukkit.getWorld(args[2]);
+
+                if (world == null) {
+                    sender.sendMessage(ChatColor.RED + "No world named " + args[2] + ".");
+                    return true;
+                }
+
+                worldName = world.getName();
+            }
+        } else if (sender instanceof Player) {
+            worldName = ((Player) sender).getWorld().getName();
+        } else {
+            sender.sendMessage(ChatColor.RED + "From the console, name the world: "
+                    + "/knockback profile " + profile.name() + " <world|default>");
+            return true;
+        }
+
+        VoidSoulKnockbackConfig.setWorldConfig(worldName, profile.build());
+        VoidSoulKnockbackConfig.applyToWorlds();
+        VoidSoulKnockbackConfig.applyHitDelay();
+
+        if (VoidSoulKnockbackConfig.save()) {
+            sender.sendMessage(ChatColor.GREEN + "Applied " + profile.name() + " to "
+                    + worldName + ChatColor.GRAY + " - previous settings for that world were "
+                    + "replaced. Edit with /knockback.");
+        } else {
+            sender.sendMessage(ChatColor.YELLOW + "Applied " + profile.name() + " to "
+                    + worldName + ", but knockback.yml could not be written. The change will "
+                    + "be lost on restart; check the console.");
+        }
+
+        return true;
+    }
+    // VoidSoulSpigot end
