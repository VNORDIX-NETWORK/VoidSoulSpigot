index 5cb06c991c9c566c70f4ddb78cfd9b76af82d5f3..d9392954f083fd432a76d872d0c10e9cd143eb5e 100644
--- a/src/main/java/com/voidsoul/spigot/config/VoidSoulKnockbackConfig.java
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulKnockbackConfig.java
@@ -146,6 +146,26 @@ public final class VoidSoulKnockbackConfig {
         }
     }
 
+    // VoidSoulSpigot start - named profiles
+    /**
+     * Replaces a world's knockback outright, as {@code /knockback profile} does.
+     * <p>
+     * "default" targets the section every world without its own entry falls back to, so
+     * applying a profile there moves the whole server.
+     *
+     * @param worldName the world, or "default"
+     * @param config    the replacement, normally from {@link
+     *                  com.voidsoul.spigot.knockback.KnockbackProfiles#build()}
+     */
+    public static void setWorldConfig(String worldName, KnockbackConfig config) {
+        if ("default".equals(worldName)) {
+            defaultWorldConfig = config;
+        } else {
+            worldConfigs.put(worldName, config);
+        }
+    }
+    // VoidSoulSpigot end
+
     public static KnockbackConfig get(String worldName) {
         KnockbackConfig config = worldConfigs.get(worldName);
         return config != null ? config : defaultWorldConfig;
