+            worlds.add("default");
+
+            for (World world : Bukkit.getWorlds()) {
+                worlds.add(world.getName());
+            }
+
+            return match(args[2], worlds);
+        }
+        // VoidSoulSpigot end
+
         if (args.length != 1) {
             return Collections.emptyList();
         }
 
         List<String> options = new ArrayList<String>();
         options.add("reload");
+        options.add("profile"); // VoidSoulSpigot - named profiles
 
         for (World world : Bukkit.getWorlds()) {
             options.add(world.getName());
         }
 
-        String prefix = args[0].toLowerCase();
+        return match(args[0], options); // VoidSoulSpigot - shared with the profile completions
+    }
