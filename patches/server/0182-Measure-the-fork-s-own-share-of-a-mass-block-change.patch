@@ -433,8 +434,16 @@ public final class PerfCommand extends Command {
     // VoidSoulSpigot start - reproducible benchmarks
     /** {@code /vs bench regioncache [files] [passes] [force]} */
     private boolean bench(CommandSender sender, String[] args) {
+        // VoidSoulSpigot - measures what the fork itself costs during a mass block change,
+        // which is the number needed to decide whether a mine reset spike is worth
+        // attacking from here or belongs to the plugin doing the resetting.
+        if (args.length >= 2 && args[1].equalsIgnoreCase("massfill")) {
+            return this.massfill(sender, args);
+        }
