@@ -483,6 +492,49 @@ public final class PerfCommand extends Command {
         return true;
     }
 
+    /** {@code /vs bench massfill [chunksPerSide] [height] [force]} */
+    private boolean massfill(CommandSender sender, String[] args) {
+        int side = parse(args, 2, 6, 1, 16);
+        int height = parse(args, 3, 64, 1, 200);
+        boolean force = args.length > 4 && args[4].equalsIgnoreCase("force");
+        int online = MinecraftServer.getServer().getPlayerList().getPlayerCount();
+
+        if (online > 0 && !force) {
+            sender.sendMessage(ChatColor.RED + "There are " + online + " players online and this "
+                    + "freezes the server while it runs. Use an empty server, or append "
+                    + ChatColor.WHITE + "force" + ChatColor.RED + ".");
+            return true;
+        }
+
+        WorldServer world = MinecraftServer.getServer().worlds.get(0);
+
+        sender.sendMessage(LABEL + "Filling " + (side * side) + " chunks, " + height
+                + " blocks tall, then clearing them...");
+
+        MassFillBenchmark.Result result;
+
+        try {
+            result = MassFillBenchmark.run(world, side, height);
+        } catch (Throwable throwable) {
+            sender.sendMessage(ChatColor.RED + "Benchmark failed: " + throwable);
+            MinecraftServer.LOGGER.warn("VoidSoul mass fill benchmark failed", throwable);
+            return true;
+        }
+
+        header(sender, "Mass block change benchmark");
+        line(sender, "Filled", result.chunks + "" + LABEL + " chunks, " + VALUE + result.blocks
+                + LABEL + " blocks in " + VALUE + String.format("%.0f ms", result.totalMillis));
+        line(sender, "Per block", String.format("%.1f us",
+                result.totalMillis * 1000.0D / Math.max(1, result.blocks)));
+        line(sender, "Relighting", String.format("%.0f ms", result.lightingMillis) + LABEL
+                + String.format("  (%.0f%% of the fill)", result.lightingShare() * 100.0D));
+        sender.sendMessage(LABEL + "This is the server's own share of a mass block change. "
+                + "Anything a mine reset costs beyond it belongs to the plugin doing the "
+                + "resetting, not to the fork.");
+        footer(sender);
+        return true;
+    }
+
     private static int parse(String[] args, int index, int fallback, int min, int max) {
         if (args.length <= index) {
             return fallback;
