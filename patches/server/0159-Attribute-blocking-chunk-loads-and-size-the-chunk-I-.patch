diff --git a/src/main/java/org/bukkit/craftbukkit/chunkio/ChunkIOExecutor.java b/src/main/java/org/bukkit/craftbukkit/chunkio/ChunkIOExecutor.java
index 69e5da4c65da46ad9d1456266cd4ad15b136f6e4..2ec0ae623e55bbc858a1a9fbf85d6c892fd6c02a 100644
--- a/src/main/java/org/bukkit/craftbukkit/chunkio/ChunkIOExecutor.java
+++ b/src/main/java/org/bukkit/craftbukkit/chunkio/ChunkIOExecutor.java
@@ -26,7 +26,19 @@ public class ChunkIOExecutor {
     }
 
     public static void adjustPoolSize(int players) {
-        int size = Math.max(BASE_THREADS, (int) Math.ceil(players / PLAYERS_PER_THREAD));
+        // VoidSoulSpigot start - configurable pool size. The original divided two ints
+        // inside Math.ceil, so the ceil did nothing and 199 players got three threads
+        // instead of four; the division is now done in floating point.
+        int perThread = com.voidsoul.spigot.config.VoidSoulConfig.getChunkIoPlayersPerThread();
+        int size = Math.max(com.voidsoul.spigot.config.VoidSoulConfig.getChunkIoMinThreads(),
+                (int) Math.ceil(players / (double) perThread));
+        int max = com.voidsoul.spigot.config.VoidSoulConfig.getChunkIoMaxThreads();
+
+        if (max > 0 && size > max) {
+            size = max;
+        }
+        // VoidSoulSpigot end
+
         instance.setActiveThreads(size);
     }
 
