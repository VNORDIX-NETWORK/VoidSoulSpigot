-        sender.sendMessage(ChatColor.DARK_GRAY + "/vs perf chunks | worlds | packets | entities | reset");
+        sender.sendMessage(ChatColor.DARK_GRAY + "/vs perf chunks | worlds | packets | entities | trace | reset");
     }
 
