@@ -322,6 +328,53 @@ public final class PerfCommand extends Command {
         footer(sender);
     }
 
+    private void trace(CommandSender sender, String argument) {
+        if (argument.equals("on") || argument.equals("off")) {
+            boolean on = argument.equals("on");
+            ChunkLoadTracker.setEnabled(on);
+            sender.sendMessage(ChatColor.GREEN + "Blocking chunk load tracing "
+                    + (on ? "on. Leave it running a few minutes, then /vs perf trace."
+                    : "off."));
+            return;
+        }
+
+        if (argument.equals("reset")) {
+            ChunkLoadTracker.reset();
+            sender.sendMessage(ChatColor.GREEN + "Chunk load callers cleared.");
+            return;
+        }
+
+        if (!ChunkLoadTracker.isEnabled()) {
+            sender.sendMessage(ChatColor.RED + "Tracing is off. Turn it on with "
+                    + ChatColor.WHITE + "/vs perf trace on" + ChatColor.RED
+                    + ", wait a few minutes, then run this again.");
+            return;
+        }
+
+        List<ChunkLoadTracker.Caller> callers = ChunkLoadTracker.top(12);
+
+        header(sender, "What is blocking on chunk loads");
+
+        if (callers.isEmpty()) {
+            sender.sendMessage(LABEL + "Nothing has blocked on a chunk load since tracing "
+                    + "was turned on. That is the answer you want.");
+            sender.sendMessage(ChatColor.DARK_GRAY + "/vs perf trace off | reset");
+            return;
+        }
+
+        for (ChunkLoadTracker.Caller caller : callers) {
+            sender.sendMessage(String.format("%s%7.0f ms %s%5d loads%s%s  %s%s",
+                    VALUE, caller.nanos() / 1_000_000.0D,
+                    VALUE, caller.loads(), LABEL,
+                    caller.generations() > 0
+                            ? ", " + caller.generations() + " generated" : "",
+                    HEAD, caller.frame));
+        }
+
+        sender.sendMessage(LABEL + "Read as: caller <- the server path it went through.");
+        sender.sendMessage(ChatColor.DARK_GRAY + "/vs perf trace off | reset");
+    }
+
     private void entities(CommandSender sender) {
         header(sender, "Entities");
 
@@ -400,7 +453,7 @@ public final class PerfCommand extends Command {
     }
 
