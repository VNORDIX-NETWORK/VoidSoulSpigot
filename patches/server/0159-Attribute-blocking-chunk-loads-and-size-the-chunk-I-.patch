diff --git a/src/main/java/com/voidsoul/spigot/perf/ChunkLoadTracker.java b/src/main/java/com/voidsoul/spigot/perf/ChunkLoadTracker.java
new file mode 100644
index 0000000000000000000000000000000000000000..d75cf42c753437e0053e8e6b252a8056b3adddd9
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/perf/ChunkLoadTracker.java
@@ -0,0 +1,171 @@
+package com.voidsoul.spigot.perf;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Works out who is causing blocking chunk loads.
+ * <p>
+ * Knowing that a world did four hundred synchronous loads a minute is only half an answer;
+ * the other half is which mine reset, which hopper, which plugin task did it, and that is
+ * not in any counter. So when tracing is on, every blocking load captures its stack and is
+ * charged to the first frame outside the server itself - the plugin that asked - falling
+ * back to the deepest server frame when nothing else is on the stack.
+ * <p>
+ * Capturing a stack costs somewhere around ten microseconds, against a disk read that costs
+ * hundreds. That ratio is why this is worth doing at all, and it is still off by default:
+ * it is a tool to point at a problem for a few minutes, not something to leave running.
+ */
+public final class ChunkLoadTracker {
+    /** Callers are kept until reset; a server has a bounded number of distinct call sites. */
+    private static final int MAX_CALLERS = 512;
+
+    private static final Map<String, Caller> CALLERS = new ConcurrentHashMap<String, Caller>();
+
+    private static volatile boolean enabled;
+
+    private ChunkLoadTracker() {
+    }
+
+    public static void setEnabled(boolean value) {
+        enabled = value;
+
+        if (!value) {
+            CALLERS.clear();
+        }
+    }
+
+    public static boolean isEnabled() {
+        return enabled;
+    }
+
+    /** One call site, with what its blocking loads have cost. */
+    public static final class Caller {
+        public final String frame;
+        final AtomicLong loads = new AtomicLong();
+        final AtomicLong nanos = new AtomicLong();
+        final AtomicLong generations = new AtomicLong();
+
+        Caller(String frame) {
+            this.frame = frame;
+        }
+
+        public long loads() {
+            return this.loads.get();
+        }
+
+        public long nanos() {
+            return this.nanos.get();
+        }
+
+        public long generations() {
+            return this.generations.get();
+        }
+    }
+
+    /**
+     * Charges one blocking load to whoever is on the stack.
+     *
+     * @param nanos      how long it took
+     * @param generated  whether the chunk had to be generated rather than read
+     */
+    public static void record(long nanos, boolean generated) {
+        if (!enabled) {
+            return;
+        }
+
+        String frame = findCaller();
+        Caller caller = CALLERS.get(frame);
+
+        if (caller == null) {
+            if (CALLERS.size() >= MAX_CALLERS) {
+                return; // a server with 512 distinct call sites has told us what we needed
+            }
+
+            Caller created = new Caller(frame);
+            caller = CALLERS.putIfAbsent(frame, created);
+
+            if (caller == null) {
+                caller = created;
+            }
+        }
+
+        caller.loads.incrementAndGet();
+        caller.nanos.addAndGet(nanos);
+
+        if (generated) {
+            caller.generations.incrementAndGet();
+        }
+    }
+
+    /**
+     * The frame to blame. Everything inside the chunk system itself is plumbing that every
+     * load goes through, so it is skipped; what is wanted is the caller that reached into
+     * a chunk in the first place.
+     */
+    private static String findCaller() {
+        StackTraceElement[] stack = new Throwable().getStackTrace();
+        StackTraceElement deepestServerFrame = null;
+
+        for (StackTraceElement element : stack) {
+            String className = element.getClassName();
+
+            if (className.startsWith("com.voidsoul.spigot.perf.")
+                    || className.equals("net.minecraft.server.ChunkProviderServer")
+                    || className.startsWith("org.bukkit.craftbukkit.chunkio.")) {
+                continue;
+            }
+
+            if (className.startsWith("net.minecraft.server.")
+                    || className.startsWith("org.bukkit.craftbukkit.")
+                    || className.startsWith("org.spigotmc.")
+                    || className.startsWith("com.hpfxd.pandaspigot.")
+                    || className.startsWith("com.voidsoul.spigot.")) {
+                if (deepestServerFrame == null) {
+                    deepestServerFrame = element;
+                }
+
+                continue;
+            }
+
+            // Something outside the server: a plugin, or the scheduler running one.
+            return format(element) + " <- " + (deepestServerFrame == null
+                    ? "?" : shortName(deepestServerFrame.getClassName()) + "." + deepestServerFrame.getMethodName());
+        }
+
+        return deepestServerFrame == null ? "unknown" : format(deepestServerFrame);
+    }
+
+    private static String format(StackTraceElement element) {
+        return shortName(element.getClassName()) + "." + element.getMethodName()
+                + ":" + element.getLineNumber();
+    }
+
+    private static String shortName(String className) {
+        int dot = className.lastIndexOf('.');
+        return dot < 0 ? className : className.substring(dot + 1);
+    }
+
+    /** Callers ordered by the main thread time they have cost, worst first. */
+    public static List<Caller> top(int limit) {
+        List<Caller> callers = new ArrayList<Caller>(CALLERS.values());
+
+        Collections.sort(callers, new Comparator<Caller>() {
+            @Override
+            public int compare(Caller a, Caller b) {
+                return Long.compare(b.nanos(), a.nanos());
+            }
+        });
+
+        return callers.size() > limit ? callers.subList(0, limit) : callers;
+    }
+
+    public static void reset() {
+        CALLERS.clear();
+    }
+}
