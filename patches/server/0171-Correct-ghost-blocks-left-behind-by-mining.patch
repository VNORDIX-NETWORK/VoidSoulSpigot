     // Spigot start
     public boolean collidesWithEntities = true;
     public int viewDistance; // PaperSpigot - Player view distance API
+    public com.voidsoul.spigot.mining.MiningResync voidsoulMining; // VoidSoulSpigot - ghost block fix, created on first dig
     private int containerUpdateDelay; // PaperSpigot
 
     @Override
@@ -241,6 +242,11 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
             this.playerConnection.sendPacket(new PacketPlayOutEntityDestroy(aint));
         }
 
+        // VoidSoulSpigot - correct any ghost blocks this player left behind while mining
+        if (this.voidsoulMining != null) {
+            this.voidsoulMining.tick(this, MinecraftServer.currentTick);
+        }
+
         if (!this.chunkCoordIntPairQueue.isEmpty()) {
             long voidsoulSendStart = com.voidsoul.spigot.perf.VoidSoulProfiler.start(); // VoidSoulSpigot - internal profiler
             long voidsoulBytes = 0L; // VoidSoulSpigot - internal profiler
diff --git a/src/main/java/net/minecraft/server/PlayerConnection.java b/src/main/java/net/minecraft/server/PlayerConnection.java
index 4988cb4de12d42eafba2e548cd61f739ffb70028..183ac5c16b62eae3d336cde8119905704c7fb8cf 100644
--- a/src/main/java/net/minecraft/server/PlayerConnection.java
+++ b/src/main/java/net/minecraft/server/PlayerConnection.java
@@ -686,6 +686,21 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
                     }
                 }
 
+                // VoidSoulSpigot start - remember what was dug so a ghost block left by a
+                // mine reset or a lost acknowledgement corrects itself shortly after.
+                com.voidsoul.spigot.config.VoidSoulWorldConfig.MiningConfig.GhostBlockFixConfig voidsoulGhostFix =
+                        worldserver.voidsoulConfig.mining.ghostBlockFix;
+
+                if (voidsoulGhostFix.enabled) {
+                    if (this.player.voidsoulMining == null) {
+                        this.player.voidsoulMining = new com.voidsoul.spigot.mining.MiningResync();
+                    }
+
+                    this.player.voidsoulMining.record(blockposition, MinecraftServer.currentTick,
+                            Math.max(1, voidsoulGhostFix.maxBlocksPerResync));
+                }
+                // VoidSoulSpigot end
+
                 return;
             }
 
