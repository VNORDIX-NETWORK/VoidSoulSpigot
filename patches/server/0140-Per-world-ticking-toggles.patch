@@ -176,6 +176,12 @@ public class TileEntityFurnace extends TileEntityContainer implements IUpdatePla
     }
 
     public void c() {
+        // VoidSoulSpigot start - toggleable furnace ticking
+        if (this.world != null && !this.world.voidsoulConfig.ticking.tickFurnaces) {
+            this.lastTick = MinecraftServer.currentTick; // keep wall-time clock in sync so re-enabling doesn't fast-forward
+            return;
+        }
+        // VoidSoulSpigot end
         boolean flag = (this.w() == Blocks.LIT_FURNACE); // CraftBukkit - SPIGOT-844 - Check if furnace block is lit using the block instead of burn time // PAIL: Rename
         boolean flag1 = false;
 
