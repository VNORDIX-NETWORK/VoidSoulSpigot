@@ -163,6 +163,22 @@ public final class PerfCommand extends Command {
                     + LABEL + " (blocking)");
             line(sender, "  Scheduler", millisPerTick(VoidSoulProfiler.schedulerNanos.window(WINDOW), tickCount));
             line(sender, "  Save", millisPerTick(VoidSoulProfiler.saveNanos.window(WINDOW), tickCount));
+
+            // VoidSoulSpigot start - whatever the sections do not cover: the network tick,
+            // the player list, tickables, and plugins running inside Bukkit events. Shown
+            // rather than left as a gap between the sections and the MSPT above, since a
+            // large "other" is where to look next.
+            double accounted = (worldNanos + entityNanos + trackerNanos + chunkLoadNanos
+                    + VoidSoulProfiler.chunkSendNanos.window(WINDOW)
+                    + VoidSoulProfiler.schedulerNanos.window(WINDOW)
+                    + VoidSoulProfiler.saveNanos.window(WINDOW)) / 1_000_000.0D / tickCount;
+            double other = ticks.average - accounted;
+
+            if (other >= 0.05D) {
+                line(sender, "  Other", String.format("%.2f ms", other) + LABEL
+                        + " (network, player list, events)");
+            }
+            // VoidSoulSpigot end
         }
 
         // VoidSoulSpigot start - what the single worst tick was actually made of.
