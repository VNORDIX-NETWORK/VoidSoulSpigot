--- a/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulConfig.java
@@ -490,6 +490,11 @@ public class VoidSoulConfig {
         }
     }
 
+    /** @return the debug settings, or null before the config has loaded. */
+    public static DebugConfig getDebug() {
+        return config == null ? null : config.debug;
+    }
+
     @Comment("Built-in performance measurement, read with /vs perf.")
     public DebugConfig debug = new DebugConfig();
 
@@ -519,6 +524,25 @@ public class VoidSoulConfig {
                 "minutes when you are hunting something. /vs perf trace on does that without\n" +
                 "a restart.")
         public boolean traceBlockingChunkLoads = false;
+
+        @Comment("Log a line whenever a single tick goes over this many milliseconds, with\n" +
+                "the breakdown of where that tick's time went.\n" +
+                "\n" +
+                "/vs perf already reports the worst tick of the last minute, but only when\n" +
+                "somebody is looking. A spike at four in the morning is gone by the time you\n" +
+                "read about it, so this writes it down as it happens.\n" +
+                "\n" +
+                "50 ms is a full tick, meaning the server is already behind by the time one\n" +
+                "is logged. Lower it to catch smaller stutters, raise it if a busy server\n" +
+                "makes the log noisy. 0 turns the logging off.")
+        public int logTickSpikesOverMs = 50;
+
+        @Comment("Never log more than one spike per this many ticks.\n" +
+                "\n" +
+                "A server that is genuinely struggling produces a spike every tick, and a\n" +
+                "log line for each of them turns a performance problem into a disk problem.\n" +
+                "Default is one every five seconds.")
+        public int spikeLogIntervalTicks = 100;
     }
 
     @Comment("Protection against malicious clients.")
