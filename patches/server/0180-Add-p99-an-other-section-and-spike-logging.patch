             worstPluginNanos[worstIndex] = topNanos;
         }
 
+        logSpike(durationNanos); // VoidSoulSpigot - write down a spike as it happens
+
         long now = System.nanoTime();
 
         if (now - lastRollNanos >= 1_000_000_000L) {
@@ -309,6 +311,66 @@ public final class VoidSoulProfiler {
         }
     }
 
+    // --- spike logging ------------------------------------------------------------------
+
+    private static int lastSpikeTick = Integer.MIN_VALUE;
+
+    /**
+     * Writes a spike to the log as it happens.
+     * <p>
+     * /vs perf reports the worst tick of the last minute, but only when somebody runs it. A
+     * spike at four in the morning is gone by the time anyone reads about it; this records
+     * it with the same breakdown, rate limited so a server that is genuinely struggling
+     * does not turn a performance problem into a disk problem.
+     */
+    private static void logSpike(long durationNanos) {
+        com.voidsoul.spigot.config.VoidSoulConfig.DebugConfig config =
+                com.voidsoul.spigot.config.VoidSoulConfig.getDebug();
+
+        if (config == null || config.logTickSpikesOverMs <= 0) {
+            return;
+        }
+
+        double millis = durationNanos / 1_000_000.0D;
+
+        if (millis < config.logTickSpikesOverMs) {
+            return;
+        }
+
+        int tick = net.minecraft.server.MinecraftServer.currentTick;
+
+        if (tick - lastSpikeTick < Math.max(1, config.spikeLogIntervalTicks)) {
+            return;
+        }
+
+        lastSpikeTick = tick;
+
+        StringBuilder message = new StringBuilder(160);
+        message.append(String.format("[VoidSoul] Tick spike: %.1f ms", millis));
+
+        double accounted = 0.0D;
+
+        for (int section = 0; section < SECTION_COUNT; section++) {
+            double cost = currentTick[section] / 1_000_000.0D;
+            accounted += cost;
+
+            if (cost >= 0.5D) {
+                message.append(String.format("  %s %.1f", SECTION_NAMES[section], cost));
+            }
+        }
+
+        double other = millis - accounted;
+
+        if (other >= 1.0D) {
+            // Named rather than hidden: the sections do not cover the network tick, the
+            // player list, or a plugin inside a Bukkit event, so a large remainder says
+            // where to look next instead of looking like a measurement failure.
+            message.append(String.format("  other %.1f", other));
+        }
+
+        org.bukkit.Bukkit.getLogger().warning(message.toString());
+    }
+
     private static void sampleGarbageCollection() {
         long collections = 0L;
         long millis = 0L;
@@ -340,13 +402,16 @@ public final class VoidSoulProfiler {
         public final double average;
         public final double median;
         public final double percentile95;
+        public final double percentile99;
         public final double max;
 
-        TickStats(int samples, double average, double median, double percentile95, double max) {
+        TickStats(int samples, double average, double median, double percentile95,
+                  double percentile99, double max) {
             this.samples = samples;
             this.average = average;
             this.median = median;
             this.percentile95 = percentile95;
+            this.percentile99 = percentile99;
             this.max = max;
         }
     }
@@ -363,7 +428,7 @@ public final class VoidSoulProfiler {
         int wanted = Math.min(seconds * 20, tickFilled);
 
         if (wanted <= 0) {
-            return new TickStats(0, 0.0D, 0.0D, 0.0D, 0.0D);
+            return new TickStats(0, 0.0D, 0.0D, 0.0D, 0.0D, 0.0D);
         }
 
         long[] sample = new long[wanted];
@@ -384,6 +449,7 @@ public final class VoidSoulProfiler {
                 toMillis(sum / (double) wanted),
                 toMillis(sample[wanted / 2]),
                 toMillis(sample[Math.min(wanted - 1, (int) (wanted * 0.95D))]),
+                toMillis(sample[Math.min(wanted - 1, (int) (wanted * 0.99D))]),
                 toMillis(sample[wanted - 1]));
     }
 
