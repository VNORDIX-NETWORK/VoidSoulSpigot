diff --git a/src/main/java/com/voidsoul/spigot/net/LoginThrottle.java b/src/main/java/com/voidsoul/spigot/net/LoginThrottle.java
new file mode 100644
index 0000000000000000000000000000000000000000..e3291c1f7d4611b6f5ec18298657279d9bfab1d5
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/net/LoginThrottle.java
@@ -0,0 +1,43 @@
+package com.voidsoul.spigot.net;
+
+import com.voidsoul.spigot.config.VoidSoulConfig;
+
+/**
+ * Caps how many players may complete the join process in one tick.
+ * <p>
+ * Finishing a login is not cheap: player data is read, the world is entered, the entity is
+ * tracked, and every plugin's PlayerJoinEvent runs. On a server with eighty plugins that is
+ * a substantial amount of work, and a restart or a proxy reconnect delivers it all at once -
+ * so the first seconds after a restart, exactly when everyone is trying to get back in, are
+ * the seconds the server can least afford it.
+ * <p>
+ * Spreading the same joins over a few ticks costs the last player in the queue a fraction of
+ * a second and keeps the server responsive for everyone already inside.
+ * <p>
+ * Main thread only; logins are completed from the server tick.
+ */
+public final class LoginThrottle {
+    private static int remaining;
+
+    private LoginThrottle() {
+    }
+
+    /** Refills the allowance. Called once at the top of the server tick. */
+    public static void startTick() {
+        remaining = VoidSoulConfig.getMaxLoginsPerTick();
+    }
+
+    /**
+     * @return whether another login may be completed this tick. Always true when no limit is
+     *         configured.
+     */
+    public static boolean tryAcquire() {
+        if (remaining <= 0) {
+            // Zero means unlimited, so it is distinguished from having run out.
+            return VoidSoulConfig.getMaxLoginsPerTick() <= 0;
+        }
+
+        remaining--;
+        return true;
+    }
+}
