--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/perf/WorldPerfStats.java
@@ -0,0 +1,53 @@
+package com.voidsoul.spigot.perf;
+
+/**
+ * Per-world counters. One instance lives on every world for its whole life.
+ * <p>
+ * A prison server runs one world per mine, so "the server is at 30 ms" is useless on its
+ * own - what matters is which of the ninety worlds is spending it, and whether it is being
+ * spent on entities, on ticking, or on pulling chunks off the disk inside the tick.
+ */
+public final class WorldPerfStats {
+    // --- chunks -------------------------------------------------------------------------
+
+    /** Chunks read from disk on the main thread, blocking the tick. */
+    public final RollingCounter chunkLoadsSync = VoidSoulProfiler.counter();
+
+    /** Chunks read through the chunk I/O threads, off the main thread. */
+    public final RollingCounter chunkLoadsAsync = VoidSoulProfiler.counter();
+
+    /** Chunks generated from scratch. Always on the main thread in 1.8. */
+    public final RollingCounter chunkGenerations = VoidSoulProfiler.counter();
+
+    /** Chunks actually written out and dropped from memory. */
+    public final RollingCounter chunkUnloads = VoidSoulProfiler.counter();
+
+    /**
+     * Chunks taken back out of the unload queue before they were unloaded - a disk round
+     * trip that did not happen. This is what tells you whether the unload delay is earning
+     * the memory it costs.
+     */
+    public final RollingCounter chunkRetains = VoidSoulProfiler.counter();
+
+    /** Main thread time spent inside blocking chunk loads and generation. */
+    public final RollingCounter chunkLoadNanos = VoidSoulProfiler.counter();
+
+    // --- chunk sending ------------------------------------------------------------------
+
+    public final RollingCounter chunksSent = VoidSoulProfiler.counter();
+    public final RollingCounter chunkBytesSent = VoidSoulProfiler.counter();
+
+    /** Chunk sends held back because the per-tick budget was already spent. */
+    public final RollingCounter chunkSendsDeferred = VoidSoulProfiler.counter();
+
+    // --- ticking ------------------------------------------------------------------------
+
+    /** Time in {@code WorldServer.doTick()} - weather, block ticks, tile entities. */
+    public final RollingCounter worldNanos = VoidSoulProfiler.counter();
+
+    /** Time in {@code WorldServer.tickEntities()}. */
+    public final RollingCounter entityNanos = VoidSoulProfiler.counter();
+
+    /** Time in the entity tracker. */
+    public final RollingCounter trackerNanos = VoidSoulProfiler.counter();
+}
