diff --git a/src/main/java/com/voidsoul/spigot/perf/PerfCommand.java b/src/main/java/com/voidsoul/spigot/perf/PerfCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..59d18e6af2e2840171c19ec4c98d954b6143e789
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/perf/PerfCommand.java
@@ -0,0 +1,409 @@
+package com.voidsoul.spigot.perf;
+
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.WorldServer;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * {@code /vs perf} - reads back what {@link VoidSoulProfiler} has been collecting.
+ */
+public final class PerfCommand extends Command {
+    public static final String PERMISSION = "voidsoul.command.perf";
+
+    /** Rates are reported over this many seconds unless the window is still filling. */
+    private static final int WINDOW = 60;
+
+    private static final ChatColor LABEL = ChatColor.GRAY;
+    private static final ChatColor VALUE = ChatColor.WHITE;
+    private static final ChatColor HEAD = ChatColor.AQUA;
+
+    private PerfCommand() {
+        super("vs");
+        this.description = "VoidSoulSpigot performance information";
+        this.usageMessage = "/vs perf [chunks|worlds|packets|entities|reset]";
+        this.setPermission(PERMISSION);
+        this.setAliases(Arrays.asList("voidsoul"));
+    }
+
+    /** Registers the command with the server. Called once on startup. */
+    public static void register() {
+        MinecraftServer.getServer().server.getCommandMap().register("voidsoul", new PerfCommand());
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String label, String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length == 0 || !args[0].equalsIgnoreCase("perf")) {
+            sender.sendMessage(ChatColor.RED + "Usage: " + this.usageMessage);
+            return true;
+        }
+
+        String section = args.length > 1 ? args[1].toLowerCase(Locale.ROOT) : "summary";
+
+        if (section.equals("summary")) {
+            this.summary(sender);
+        } else if (section.equals("chunks")) {
+            this.chunks(sender);
+        } else if (section.equals("worlds")) {
+            this.worlds(sender);
+        } else if (section.equals("packets")) {
+            this.packets(sender);
+        } else if (section.equals("entities")) {
+            this.entities(sender);
+        } else if (section.equals("reset")) {
+            VoidSoulProfiler.reset();
+            sender.sendMessage(ChatColor.GREEN + "Performance counters reset.");
+        } else {
+            sender.sendMessage(ChatColor.RED + "Usage: " + this.usageMessage);
+        }
+
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        if (args.length == 1) {
+            return partial(args[0], Collections.singletonList("perf"));
+        }
+
+        if (args.length == 2 && args[0].equalsIgnoreCase("perf")) {
+            return partial(args[1], Arrays.asList("chunks", "worlds", "packets", "entities", "reset"));
+        }
+
+        return Collections.emptyList();
+    }
+
+    private static List<String> partial(String prefix, List<String> options) {
+        List<String> matches = new ArrayList<String>();
+        String lower = prefix.toLowerCase(Locale.ROOT);
+
+        for (String option : options) {
+            if (option.startsWith(lower)) {
+                matches.add(option);
+            }
+        }
+
+        return matches;
+    }
+
+    // --- sections -----------------------------------------------------------------------
+
+    private void summary(CommandSender sender) {
+        MinecraftServer server = MinecraftServer.getServer();
+        VoidSoulProfiler.TickStats ticks = VoidSoulProfiler.tickStats(WINDOW);
+
+        header(sender, "VoidSoulSpigot performance");
+
+        double[] tps = server.recentTps;
+        line(sender, "TPS", String.format("%.2f, %.2f, %.2f %s(1m, 5m, 15m)",
+                Math.min(20.0D, tps[0]), Math.min(20.0D, tps[1]), Math.min(20.0D, tps[2]), LABEL));
+
+        if (ticks.samples == 0) {
+            line(sender, "MSPT", "collecting...");
+        } else {
+            line(sender, "MSPT", String.format("avg %.1f  p50 %.1f  p95 %.1f  max %.1f",
+                    ticks.average, ticks.median, ticks.percentile95, ticks.max));
+        }
+
+        if (VoidSoulProfiler.isTimingsEnabled()) {
+            sender.sendMessage(HEAD + "Main thread " + LABEL + "(ms per tick)");
+
+            long worldNanos = 0L;
+            long entityNanos = 0L;
+            long trackerNanos = 0L;
+            long chunkLoadNanos = 0L;
+
+            for (WorldServer world : server.worlds) {
+                WorldPerfStats stats = world.voidsoulStats;
+                worldNanos += stats.worldNanos.window(WINDOW);
+                entityNanos += stats.entityNanos.window(WINDOW);
+                trackerNanos += stats.trackerNanos.window(WINDOW);
+                chunkLoadNanos += stats.chunkLoadNanos.window(WINDOW);
+            }
+
+            int tickCount = Math.max(1, ticks.samples);
+
+            line(sender, "  Worlds", millisPerTick(worldNanos, tickCount));
+            line(sender, "  Entities", millisPerTick(entityNanos, tickCount));
+            line(sender, "  Tracker", millisPerTick(trackerNanos, tickCount));
+            line(sender, "  Chunk send", millisPerTick(VoidSoulProfiler.chunkSendNanos.window(WINDOW), tickCount));
+            line(sender, "  Chunk load", millisPerTick(chunkLoadNanos, tickCount)
+                    + LABEL + " (blocking)");
+            line(sender, "  Scheduler", millisPerTick(VoidSoulProfiler.schedulerNanos.window(WINDOW), tickCount));
+            line(sender, "  Save", millisPerTick(VoidSoulProfiler.saveNanos.window(WINDOW), tickCount));
+        }
+
+        long loaded = 0L;
+        long queued = 0L;
+        long syncLoads = 0L;
+        long generated = 0L;
+
+        for (WorldServer world : server.worlds) {
+            loaded += world.chunkProviderServer.chunks.size();
+            queued += world.chunkProviderServer.unloadQueue.size();
+            syncLoads += world.voidsoulStats.chunkLoadsSync.window(WINDOW);
+            generated += world.voidsoulStats.chunkGenerations.window(WINDOW);
+        }
+
+        sender.sendMessage(HEAD + "Chunks");
+        line(sender, "  Loaded", loaded + "" + LABEL + "  unload queue " + VALUE + queued);
+        line(sender, "  Blocking", perSecond(syncLoads) + " loads/s, "
+                + perSecond(generated) + " generated/s");
+
+        sender.sendMessage(HEAD + "Network");
+        line(sender, "  In", String.format("%s pkt/s  %s/s",
+                perSecond(VoidSoulProfiler.packetsIn.window(WINDOW)),
+                bytes(VoidSoulProfiler.bytesIn.window(WINDOW) / windowSeconds())));
+        line(sender, "  Out", String.format("%s pkt/s  %s/s",
+                perSecond(VoidSoulProfiler.packetsOut.window(WINDOW)),
+                bytes(VoidSoulProfiler.bytesOut.window(WINDOW) / windowSeconds())));
+
+        Runtime runtime = Runtime.getRuntime();
+        long used = (runtime.totalMemory() - runtime.freeMemory()) / 1048576L;
+        long max = runtime.maxMemory() / 1048576L;
+
+        sender.sendMessage(HEAD + "Memory");
+        line(sender, "  Heap", used + "/" + max + " MB");
+        line(sender, "  GC", VoidSoulProfiler.gcCount.window(WINDOW) + " collections, "
+                + String.format("%.0f ms", VoidSoulProfiler.gcNanos.window(WINDOW) / 1_000_000.0D)
+                + LABEL + " (last " + windowSeconds() + "s)");
+
+        footer(sender);
+    }
+
+    private void chunks(CommandSender sender) {
+        header(sender, "Chunks, last " + windowSeconds() + "s");
+
+        List<WorldServer> worlds = sortedWorlds(new Comparator<WorldServer>() {
+            @Override
+            public int compare(WorldServer a, WorldServer b) {
+                return Long.compare(b.voidsoulStats.chunkLoadNanos.window(WINDOW),
+                        a.voidsoulStats.chunkLoadNanos.window(WINDOW));
+            }
+        });
+
+        for (WorldServer world : worlds) {
+            WorldPerfStats stats = world.voidsoulStats;
+
+            long sync = stats.chunkLoadsSync.window(WINDOW);
+            long async = stats.chunkLoadsAsync.window(WINDOW);
+            long generated = stats.chunkGenerations.window(WINDOW);
+            long unloaded = stats.chunkUnloads.window(WINDOW);
+            long retained = stats.chunkRetains.window(WINDOW);
+            long sent = stats.chunksSent.window(WINDOW);
+
+            if ((sync | async | generated | unloaded | retained | sent) == 0L) {
+                continue; // an idle mine world says nothing worth a line
+            }
+
+            sender.sendMessage(HEAD + world.worldData.getName() + LABEL + "  loaded "
+                    + VALUE + world.chunkProviderServer.chunks.size() + LABEL + ", queued "
+                    + VALUE + world.chunkProviderServer.unloadQueue.size());
+
+            line(sender, "  Loads", "sync " + VALUE + sync + LABEL + "  async " + VALUE + async
+                    + LABEL + "  generated " + VALUE + generated
+                    + LABEL + "  (" + String.format("%.1f ms/tick blocking",
+                    stats.chunkLoadNanos.window(WINDOW) / 1_000_000.0D / Math.max(1, WINDOW * 20)) + ")");
+            line(sender, "  Unloads", unloaded + "" + LABEL + "  retained " + VALUE + retained
+                    + LABEL + retainHint(unloaded, retained));
+            line(sender, "  Sent", sent + "" + LABEL + " chunks, " + VALUE
+                    + bytes(stats.chunkBytesSent.window(WINDOW)) + LABEL + ", deferred "
+                    + VALUE + stats.chunkSendsDeferred.window(WINDOW));
+        }
+
+        footer(sender);
+    }
+
+    /**
+     * Retains are only meaningful next to unloads: a high ratio means the unload delay is
+     * paying for itself, a ratio near zero means it is only costing memory.
+     */
+    private static String retainHint(long unloaded, long retained) {
+        long total = unloaded + retained;
+
+        if (total < 20L) {
+            return "";
+        }
+
+        return String.format("  (%.0f%% saved)", 100.0D * retained / total);
+    }
+
+    private void worlds(CommandSender sender) {
+        if (!VoidSoulProfiler.isTimingsEnabled()) {
+            sender.sendMessage(ChatColor.RED
+                    + "Section timing is off. Enable debug.profiler in VoidSoul/voidsoul.yml.");
+            return;
+        }
+
+        header(sender, "Worlds by main thread time, last " + windowSeconds() + "s");
+
+        List<WorldServer> worlds = sortedWorlds(new Comparator<WorldServer>() {
+            @Override
+            public int compare(WorldServer a, WorldServer b) {
+                return Long.compare(total(b.voidsoulStats), total(a.voidsoulStats));
+            }
+        });
+
+        int tickCount = Math.max(1, VoidSoulProfiler.tickStats(WINDOW).samples);
+        int shown = 0;
+
+        for (WorldServer world : worlds) {
+            WorldPerfStats stats = world.voidsoulStats;
+            long nanos = total(stats);
+
+            if (nanos == 0L || shown++ >= 15) {
+                continue;
+            }
+
+            sender.sendMessage(String.format("%s%-20s %s%6.2f ms %s(world %.2f, entities %.2f, tracker %.2f)",
+                    HEAD, trim(world.worldData.getName(), 20), VALUE,
+                    nanos / 1_000_000.0D / tickCount, LABEL,
+                    stats.worldNanos.window(WINDOW) / 1_000_000.0D / tickCount,
+                    stats.entityNanos.window(WINDOW) / 1_000_000.0D / tickCount,
+                    stats.trackerNanos.window(WINDOW) / 1_000_000.0D / tickCount));
+        }
+
+        if (shown == 0) {
+            sender.sendMessage(LABEL + "No world has used measurable time yet.");
+        }
+
+        footer(sender);
+    }
+
+    private static long total(WorldPerfStats stats) {
+        return stats.worldNanos.window(WINDOW)
+                + stats.entityNanos.window(WINDOW)
+                + stats.trackerNanos.window(WINDOW);
+    }
+
+    private void packets(CommandSender sender) {
+        header(sender, "Network, last " + windowSeconds() + "s");
+
+        long in = VoidSoulProfiler.packetsIn.window(WINDOW);
+        long out = VoidSoulProfiler.packetsOut.window(WINDOW);
+        long bytesIn = VoidSoulProfiler.bytesIn.window(WINDOW);
+        long bytesOut = VoidSoulProfiler.bytesOut.window(WINDOW);
+        int seconds = windowSeconds();
+
+        line(sender, "Incoming", perSecond(in) + " pkt/s  " + bytes(bytesIn / seconds) + "/s");
+        line(sender, "Outgoing", perSecond(out) + " pkt/s  " + bytes(bytesOut / seconds) + "/s");
+
+        long chunkBytes = 0L;
+        long chunkCount = 0L;
+
+        for (WorldServer world : MinecraftServer.getServer().worlds) {
+            chunkBytes += world.voidsoulStats.chunkBytesSent.window(WINDOW);
+            chunkCount += world.voidsoulStats.chunksSent.window(WINDOW);
+        }
+
+        line(sender, "Chunk share", bytes(chunkBytes / seconds) + "/s"
+                + (bytesOut > 0L ? LABEL + String.format("  (%.0f%% of outgoing)",
+                100.0D * chunkBytes / bytesOut) : "")
+                + LABEL + ", " + VALUE + perSecond(chunkCount) + LABEL + " chunks/s");
+
+        int players = MinecraftServer.getServer().getPlayerList().getPlayerCount();
+
+        if (players > 0) {
+            line(sender, "Per player", bytes(bytesOut / seconds / players) + "/s out");
+        }
+
+        footer(sender);
+    }
+
+    private void entities(CommandSender sender) {
+        header(sender, "Entities");
+
+        List<WorldServer> worlds = sortedWorlds(new Comparator<WorldServer>() {
+            @Override
+            public int compare(WorldServer a, WorldServer b) {
+                return Integer.compare(b.entityList.size(), a.entityList.size());
+            }
+        });
+
+        int tickCount = Math.max(1, VoidSoulProfiler.tickStats(WINDOW).samples);
+        int shown = 0;
+
+        for (WorldServer world : worlds) {
+            if (world.entityList.isEmpty() && world.tileEntityList.isEmpty()) {
+                continue;
+            }
+
+            if (shown++ >= 15) {
+                break;
+            }
+
+            sender.sendMessage(String.format("%s%-18s %s%5d %sentities %s%5d %stiles %s%5d %splayers %s%.2f ms",
+                    HEAD, trim(world.worldData.getName(), 18),
+                    VALUE, world.entityList.size(), LABEL,
+                    VALUE, world.tileEntityList.size(), LABEL,
+                    VALUE, world.players.size(), LABEL,
+                    VALUE, world.voidsoulStats.entityNanos.window(WINDOW) / 1_000_000.0D / tickCount));
+        }
+
+        if (shown == 0) {
+            sender.sendMessage(LABEL + "No entities in any world.");
+        }
+
+        footer(sender);
+    }
+
+    // --- formatting ---------------------------------------------------------------------
+
+    private static List<WorldServer> sortedWorlds(Comparator<WorldServer> comparator) {
+        List<WorldServer> worlds = new ArrayList<WorldServer>(MinecraftServer.getServer().worlds);
+        Collections.sort(worlds, comparator);
+        return worlds;
+    }
+
+    /**
+     * Deliberately not derived from {@link VoidSoulProfiler#tickStats}: that sorts a copy of
+     * the tick history, and this is called from inside every rate that gets printed.
+     */
+    private static int windowSeconds() {
+        return Math.max(1, Math.min(WINDOW, VoidSoulProfiler.collectedSeconds()));
+    }
+
+    private static String millisPerTick(long nanos, int ticks) {
+        return String.format("%.2f ms", nanos / 1_000_000.0D / ticks);
+    }
+
+    private static String perSecond(long windowTotal) {
+        double rate = (double) windowTotal / windowSeconds();
+        return rate >= 10.0D ? String.format("%.0f", rate) : String.format("%.1f", rate);
+    }
+
+    private static String bytes(long value) {
+        if (value < 1024L) return value + " B";
+        if (value < 1048576L) return String.format("%.1f KB", value / 1024.0D);
+        return String.format("%.2f MB", value / 1048576.0D);
+    }
+
+    private static String trim(String value, int length) {
+        return value.length() <= length ? value : value.substring(0, length - 1) + "…";
+    }
+
+    private static void header(CommandSender sender, String title) {
+        sender.sendMessage(ChatColor.DARK_AQUA + "━━ " + ChatColor.AQUA + title
+                + ChatColor.DARK_AQUA + " ━━");
+    }
+
+    private static void footer(CommandSender sender) {
+        sender.sendMessage(ChatColor.DARK_GRAY + "/vs perf chunks | worlds | packets | entities | reset");
+    }
+
+    private static void line(CommandSender sender, String label, String value) {
+        sender.sendMessage(LABEL + label + ": " + VALUE + value);
+    }
+}
diff --git a/src/main/java/com/voidsoul/spigot/perf/RollingCounter.java b/src/main/java/com/voidsoul/spigot/perf/RollingCounter.java
new file mode 100644
index 0000000000000000000000000000000000000000..f5958c7c323331077ccfca2e229735480d1717ac
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/perf/RollingCounter.java
@@ -0,0 +1,79 @@
+package com.voidsoul.spigot.perf;
+
+import java.util.Arrays;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * A running total plus one bucket per second for the last minute.
+ * <p>
+ * Counters are written from hot paths - chunk loads, packet sends - and read once, by hand,
+ * from a command. So the write side is a {@link LongAdder} increment and nothing else: no
+ * timestamps, no allocation, no synchronization. The per-second buckets are closed by
+ * {@link #roll()} from the tick loop, which is what lets a rate be read back afterwards.
+ */
+public final class RollingCounter {
+    private final LongAdder total = new LongAdder();
+    private final long[] perSecond;
+    private long lastRolled;
+    private int index;
+    private int filled;
+
+    RollingCounter(int windowSeconds) {
+        this.perSecond = new long[windowSeconds];
+    }
+
+    public void increment() {
+        this.total.increment();
+    }
+
+    public void add(long amount) {
+        this.total.add(amount);
+    }
+
+    public long total() {
+        return this.total.sum();
+    }
+
+    /** Closes the current second's bucket. Called once a second from the tick loop. */
+    void roll() {
+        long now = this.total.sum();
+
+        this.perSecond[this.index] = now - this.lastRolled;
+        this.lastRolled = now;
+        this.index = (this.index + 1) % this.perSecond.length;
+
+        if (this.filled < this.perSecond.length) {
+            this.filled++;
+        }
+    }
+
+    /**
+     * Sum over the last {@code seconds} closed seconds, capped at how long the server has
+     * actually been collecting so a young server doesn't report a rate averaged over time
+     * it wasn't running.
+     */
+    public long window(int seconds) {
+        int n = Math.min(seconds, this.filled);
+        long sum = 0L;
+
+        for (int i = 1; i <= n; i++) {
+            sum += this.perSecond[Math.floorMod(this.index - i, this.perSecond.length)];
+        }
+
+        return sum;
+    }
+
+    /** Per-second rate over the last {@code seconds} closed seconds. */
+    public double rate(int seconds) {
+        int n = Math.min(seconds, this.filled);
+        return n == 0 ? 0.0D : (double) this.window(n) / n;
+    }
+
+    void reset() {
+        this.total.reset();
+        Arrays.fill(this.perSecond, 0L);
+        this.lastRolled = 0L;
+        this.index = 0;
+        this.filled = 0;
+    }
+}
diff --git a/src/main/java/com/voidsoul/spigot/perf/VoidSoulProfiler.java b/src/main/java/com/voidsoul/spigot/perf/VoidSoulProfiler.java
new file mode 100644
index 0000000000000000000000000000000000000000..98559ef22a529a53a68af3ecfafe3fbe52ddc711
--- /dev/null
+++ b/src/main/java/com/voidsoul/spigot/perf/VoidSoulProfiler.java
@@ -0,0 +1,226 @@
+package com.voidsoul.spigot.perf;
+
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * VoidSoulSpigot's internal profiler.
+ * <p>
+ * Spigot's timings answer "which plugin", which is the wrong question on a server whose
+ * cost is chunk I/O and world count. This answers "which world, how many chunks, how many
+ * of those loads blocked the main thread, how many bytes of chunk went out" - the numbers
+ * needed to tell whether a chunk change actually helped.
+ * <p>
+ * The counters are always on, because a {@link java.util.concurrent.atomic.LongAdder}
+ * increment on a path that is already doing disk I/O or building a 90 KB packet is free.
+ * The {@code System.nanoTime()} section timers are behind {@link #setTimingsEnabled} so a
+ * server that wants literally zero overhead can turn them off; they cost roughly ten
+ * nanoTime calls per world per tick, which is a few microseconds out of fifty milliseconds.
+ */
+public final class VoidSoulProfiler {
+    /** How many seconds of per-second history every counter keeps. */
+    public static final int WINDOW_SECONDS = 60;
+
+    /** How many individual tick durations are kept, for percentiles. One minute at 20 TPS. */
+    private static final int TICK_HISTORY = WINDOW_SECONDS * 20;
+
+    private static final List<RollingCounter> COUNTERS = new CopyOnWriteArrayList<RollingCounter>();
+
+    /** Creates a counter and registers it so it takes part in rolling and resetting. */
+    static RollingCounter counter() {
+        RollingCounter counter = new RollingCounter(WINDOW_SECONDS);
+        COUNTERS.add(counter);
+        return counter;
+    }
+
+    private VoidSoulProfiler() {
+    }
+
+    // --- switches -----------------------------------------------------------------------
+
+    private static volatile boolean timings = true;
+
+    public static void setTimingsEnabled(boolean enabled) {
+        timings = enabled;
+    }
+
+    public static boolean isTimingsEnabled() {
+        return timings;
+    }
+
+    /**
+     * @return a start stamp to hand to {@link #record}, or 0 when section timing is off.
+     */
+    public static long start() {
+        return timings ? System.nanoTime() : 0L;
+    }
+
+    /** Adds the time since {@code start} to {@code counter}. A start of 0 is ignored. */
+    public static void record(RollingCounter counter, long start) {
+        if (start != 0L) {
+            counter.add(System.nanoTime() - start);
+        }
+    }
+
+    // --- global sections ----------------------------------------------------------------
+
+    /** Time spent draining the main thread task queue and the Bukkit scheduler. */
+    public static final RollingCounter schedulerNanos = counter();
+
+    /** Time spent building and queueing chunk packets for players. */
+    public static final RollingCounter chunkSendNanos = counter();
+
+    /** Time spent in the periodic world save. */
+    public static final RollingCounter saveNanos = counter();
+
+    // --- network ------------------------------------------------------------------------
+    // Written from Netty event loop threads.
+
+    public static final RollingCounter packetsIn = counter();
+    public static final RollingCounter packetsOut = counter();
+    public static final RollingCounter bytesIn = counter();
+    public static final RollingCounter bytesOut = counter();
+
+    // --- garbage collection -------------------------------------------------------------
+
+    public static final RollingCounter gcCount = counter();
+    public static final RollingCounter gcNanos = counter();
+
+    private static final GarbageCollectorMXBean[] GC_BEANS =
+            ManagementFactory.getGarbageCollectorMXBeans().toArray(new GarbageCollectorMXBean[0]);
+    private static long lastGcCount = -1L;
+    private static long lastGcMillis;
+
+    // --- tick timing --------------------------------------------------------------------
+
+    private static final long[] tickNanos = new long[TICK_HISTORY];
+    private static int tickIndex;
+    private static int tickFilled;
+
+    private static long lastRollNanos;
+
+    /**
+     * Records one finished tick and, on a second boundary, closes every counter's bucket.
+     * Called from the end of the server tick.
+     *
+     * @param durationNanos how long the tick took
+     */
+    public static void endTick(long durationNanos) {
+        tickNanos[tickIndex] = durationNanos;
+        tickIndex = (tickIndex + 1) % TICK_HISTORY;
+
+        if (tickFilled < TICK_HISTORY) {
+            tickFilled++;
+        }
+
+        long now = System.nanoTime();
+
+        if (now - lastRollNanos >= 1_000_000_000L) {
+            lastRollNanos = now;
+            sampleGarbageCollection();
+
+            for (RollingCounter counter : COUNTERS) {
+                counter.roll();
+            }
+        }
+    }
+
+    private static void sampleGarbageCollection() {
+        long collections = 0L;
+        long millis = 0L;
+
+        for (GarbageCollectorMXBean bean : GC_BEANS) {
+            long count = bean.getCollectionCount();
+            long time = bean.getCollectionTime();
+
+            // A bean reports -1 when it cannot measure; treat that as no data rather than
+            // letting it drag the totals backwards.
+            if (count > 0L) collections += count;
+            if (time > 0L) millis += time;
+        }
+
+        if (lastGcCount >= 0L) {
+            gcCount.add(collections - lastGcCount);
+            gcNanos.add((millis - lastGcMillis) * 1_000_000L);
+        }
+
+        lastGcCount = collections;
+        lastGcMillis = millis;
+    }
+
+    // --- tick statistics ----------------------------------------------------------------
+
+    /** Snapshot of the tick durations over the collected window, in milliseconds. */
+    public static final class TickStats {
+        public final int samples;
+        public final double average;
+        public final double median;
+        public final double percentile95;
+        public final double max;
+
+        TickStats(int samples, double average, double median, double percentile95, double max) {
+            this.samples = samples;
+            this.average = average;
+            this.median = median;
+            this.percentile95 = percentile95;
+            this.max = max;
+        }
+    }
+
+    /** How many whole seconds of tick history have been collected, capped at the window. */
+    public static int collectedSeconds() {
+        return Math.min(WINDOW_SECONDS, tickFilled / 20);
+    }
+
+    /**
+     * @param seconds how far back to look, capped at the collected window
+     */
+    public static TickStats tickStats(int seconds) {
+        int wanted = Math.min(seconds * 20, tickFilled);
+
+        if (wanted <= 0) {
+            return new TickStats(0, 0.0D, 0.0D, 0.0D, 0.0D);
+        }
+
+        long[] sample = new long[wanted];
+
+        for (int i = 0; i < wanted; i++) {
+            sample[i] = tickNanos[Math.floorMod(tickIndex - 1 - i, TICK_HISTORY)];
+        }
+
+        long sum = 0L;
+        for (long value : sample) {
+            sum += value;
+        }
+
+        Arrays.sort(sample);
+
+        return new TickStats(
+                wanted,
+                toMillis(sum / (double) wanted),
+                toMillis(sample[wanted / 2]),
+                toMillis(sample[Math.min(wanted - 1, (int) (wanted * 0.95D))]),
+                toMillis(sample[wanted - 1]));
+    }
+
+    private static double toMillis(double nanos) {
+        return nanos / 1_000_000.0D;
+    }
+
+    // --- maintenance --------------------------------------------------------------------
+
+    /** Clears every counter and the tick history. */
+    public static void reset() {
+        for (RollingCounter counter : COUNTERS) {
+            counter.reset();
+        }
+
+        Arrays.fill(tickNanos, 0L);
+        tickIndex = 0;
+        tickFilled = 0;
+        lastGcCount = -1L;
+    }
+}
