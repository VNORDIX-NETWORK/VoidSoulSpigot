+    // VoidSoulSpigot start - configurable projectile trajectory randomness
+    /**
+     * @return Multiplier for the random spread applied when this projectile is launched.
+     *         1.0 is vanilla behaviour, 0.0 makes the trajectory exact.
+     */
+    protected double trajectoryRandomnessMultiplier() {
+        return 1.0D;
+    }
+    // VoidSoulSpigot end
+
     public void shoot(double d0, double d1, double d2, float f, float f1) {
         float f2 = MathHelper.sqrt(d0 * d0 + d1 * d1 + d2 * d2);
 
         d0 /= (double) f2;
         d1 /= (double) f2;
         d2 /= (double) f2;
-        d0 += this.random.nextGaussian() * 0.007499999832361937D * (double) f1;
-        d1 += this.random.nextGaussian() * 0.007499999832361937D * (double) f1;
