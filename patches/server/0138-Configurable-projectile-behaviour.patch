+        // VoidSoulSpigot start - configurable projectile trajectory randomness
+        double randomness = 0.007499999832361937D * this.trajectoryRandomnessMultiplier();
+        d0 += this.random.nextGaussian() * randomness * (double) f1;
+        d1 += this.random.nextGaussian() * randomness * (double) f1;
+        d2 += this.random.nextGaussian() * randomness * (double) f1;
+        // VoidSoulSpigot end
         d0 *= (double) f;
         d1 *= (double) f;
         d2 *= (double) f;
