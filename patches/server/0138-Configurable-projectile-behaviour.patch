From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emmanuel Velez Garcia <velezgarciaemmanuel25@gmail.com>
Date: Wed, 22 Jul 2026 09:58:46 -0500
Subject: [PATCH] Configurable projectile behaviour

- projectiles.{snowball,egg,pearl,potion}Randomness: multipliers for the
  random spread applied when throwable projectiles are launched.
  1.0 is vanilla, 0.0 makes trajectories exact.
- projectiles.pearlDamage: fall damage dealt when teleporting with an
  ender pearl (vanilla 5.0, 0 disables it, skipping the damage event
  entirely).

diff --git a/src/main/java/com/voidsoul/spigot/config/VoidSoulWorldConfig.java b/src/main/java/com/voidsoul/spigot/config/VoidSoulWorldConfig.java
index 605c60fa806dde7644753fa7248e768f50c3c550..a99b61fa8e3f40705dc076d893f6ad11f0d91f40 100644
--- a/src/main/java/com/voidsoul/spigot/config/VoidSoulWorldConfig.java
+++ b/src/main/java/com/voidsoul/spigot/config/VoidSoulWorldConfig.java
@@ -50,4 +50,22 @@ public class VoidSoulWorldConfig {
         public double rodHorizontalMultiplier = 1.0;
         public double rodVerticalMultiplier = 1.0;
     }
+
+    @Comment("Projectile behaviour settings.")
+    public ProjectilesConfig projectiles;
+
+    @ConfigSerializable
+    public static class ProjectilesConfig {
+        @Comment("Multipliers for the random spread applied when these projectiles are\n" +
+                "launched. 1.0 is vanilla behaviour, 0.0 removes the randomness entirely\n" +
+                "so projectiles fly exactly where aimed.")
+        public double snowballRandomness = 1.0;
+        public double eggRandomness = 1.0;
+        public double pearlRandomness = 1.0;
+        public double potionRandomness = 1.0;
+
+        @Comment("Fall damage dealt to a player when teleporting with an ender pearl.\n" +
+                "Vanilla: 5.0. Set to 0 to disable pearl damage.")
+        public double pearlDamage = 5.0;
+    }
 }
diff --git a/src/main/java/net/minecraft/server/EntityEgg.java b/src/main/java/net/minecraft/server/EntityEgg.java
